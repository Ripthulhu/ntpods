<?xml version="1.0" encoding="utf-8"?>
<!--
    Built by build-msi.ps1 from a make-dist.ps1 distribution.
    msi-setup.ps1 handles driver signing, installation and elevated helper tasks.
    App files go to Program Files; user data stays in %LOCALAPPDATA%\NTPods.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="NTPods" Manufacturer="NTPods" Version="$(Version)"
           UpgradeCode="6F0B2D57-4C1E-4E8B-9C2F-6E7A1D3B5A90"
           Scope="perMachine" Compressed="yes" Language="1033">

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of NTPods is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="NTPodsIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="NTPodsIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Ripthulhu/ntpods" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Ripthulhu/ntpods/issues" />
    <!-- Reuse installed drivers for an explicit app-only major upgrade. -->
    <Property Id="APPONLYUPGRADE" Secure="yes" />
    <!-- Our shutdown waits for microphone recovery; Restart Manager must not end it early. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />

    <Property Id="EXISTINGINSTALL" Secure="yes">
      <RegistrySearch Id="ExistingInstall" Root="HKLM" Key="Software\NTPods" Name="InstallKind" Type="raw" />
    </Property>
    <Property Id="INSTALLEDUSERSID" Secure="yes">
      <RegistrySearch Id="InstalledUser" Root="HKLM" Key="Software\NTPods" Name="InstalledUserSid" Type="raw" />
    </Property>
    <Property Id="OWNEDDRIVERS" Secure="yes">
      <RegistrySearch Id="DriverOwnership" Root="HKLM" Key="Software\NTPods" Name="DirectBluetoothDrivers" Type="raw" />
    </Property>
    <Property Id="OLDMSIDRIVERS" Secure="yes">
      <RegistrySearch Id="OldMsiDrivers" Root="HKLM" Key="Software\NTPods" Name="Drivers" Type="raw" />
    </Property>
    <Property Id="STARTUPAPP" Secure="yes">
      <RegistrySearch Id="StartupApp" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="NTPods" Type="raw" />
    </Property>
    <Property Id="STARTUPDAEMON" Secure="yes">
      <RegistrySearch Id="StartupDaemon" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="NTPods Daemon" Type="raw" />
    </Property>

    <!-- The drivers are test-signed, so Windows only loads them in Test Mode. -->
    <Property Id="BOOTOPTIONS" Secure="yes">
      <RegistrySearch Id="BootOptions" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control"
                      Name="SystemStartOptions" Type="raw" />
    </Property>
    <!-- Validate after feature selection, before stopping the old app or changing files. -->
    <CustomAction Id="RequireDriverTestMode"
                  Error="Direct Bluetooth drivers require Test Mode. For a USB dongle, leave Direct Bluetooth drivers unselected; no Test Mode is needed.&#13;&#10;&#13;&#10;These experimental drivers are not Microsoft production-signed. On a dedicated test PC, save your BitLocker recovery key, disable Secure Boot if needed, run bcdedit /set testsigning on in an administrator terminal, then restart Windows. Setup does not change boot settings." />

    <!-- ACX requires build 22621 or newer. Read the registry because MSI's
         VersionNT/WindowsBuild properties are frozen on Windows 10 and later. -->
    <Property Id="OSBUILD">
      <RegistrySearch Id="OsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" />
    </Property>
    <Launch Condition="Installed OR OSBUILD &gt;= 22621"
            Message="NTPods requires Windows 11 22H2 or newer." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NTPods" />
    </StandardDirectory>
    <SetDirectory Id="INSTALLFOLDER" Value="[ProgramFiles64Folder]NTPods" Sequence="both" />

    <!-- Everything make-dist.ps1 assembled, except the zip installer itself. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(DistDir)\**">
        <Exclude Files="$(DistDir)\install.ps1" />
      </Files>
    </ComponentGroup>

    <!-- MSI restores these values on rollback, including a failed ZIP conversion. -->
    <Component Id="InstallMetadata" Directory="INSTALLFOLDER" Guid="A7DD1024-3DBA-4C90-9E2D-92C36F4464A5">
      <RegistryValue Root="HKLM" Key="Software\NTPods" Name="InstallKind" Type="string" Value="msi" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\NTPods" Name="InstalledUserSid" Type="string" Value="[UserSID]" />
      <RegistryValue Root="HKLM" Key="Software\NTPods" Name="DirectBluetoothDrivers" Type="integer" Value="[InstallDriverOwnership]" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="3B8E4C21-7D5A-4F0E-A1C6-2D9B8E5F7A13">
      <Shortcut Id="StartMenuNTPods" Name="NTPods" Description="AirPods on Windows"
                Target="[INSTALLFOLDER]winui\ntpods-winui.exe" WorkingDirectory="WinuiDir" Icon="NTPodsIcon" />
      <RegistryValue Root="HKLM" Key="Software\NTPods" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="9C4A1E6B-2F8D-4B3A-8E7C-5D1F0A2B6C84">
      <Shortcut Id="DesktopNTPods" Name="NTPods" Description="AirPods on Windows"
                Target="[INSTALLFOLDER]winui\ntpods-winui.exe" WorkingDirectory="WinuiDir" Icon="NTPodsIcon" />
      <RegistryValue Root="HKLM" Key="Software\NTPods" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Run values belong to the app's setting, not MSI component repair. -->
    <Component Id="StartWithWindows" Directory="INSTALLFOLDER" Guid="79B5017C-55B8-484F-8F88-7A95080B012C">
      <RegistryValue Root="HKLM" Key="Software\NTPods" Name="StartupFeature" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Holds no files: selecting it is what makes msi-setup.ps1 install the drivers. -->
    <Component Id="DriversMarker" Directory="INSTALLFOLDER" Guid="5A0E3F82-1B7C-4D6E-9F2A-8C4B7D3E1F06">
      <RegistryValue Root="HKLM" Key="Software\NTPods" Name="Drivers" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Retain the ACX feature marker for upgrade and uninstall tracking. -->
    <Component Id="MicAcxMarker" Directory="INSTALLFOLDER" Guid="B7C2E4A1-9D3F-4E6B-8A5C-1F0D2E3B4C57">
      <RegistryValue Root="HKLM" Key="Software\NTPods" Name="MicAcx" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="WinuiDir" Name="winui" />
    </DirectoryRef>

    <Feature Id="Main" Title="NTPods" AllowAbsent="no" Display="expand"
             Description="The app and a Start menu entry. USB dongles use Windows' built-in USB drivers and do not require Test Mode.">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="InstallMetadata" />

      <Feature Id="Drivers" Title="Direct Bluetooth drivers (Test Mode)" Level="2" AllowAdvertise="no"
               Description="Optional: use the PC's Bluetooth adapter. Installs test-signed AirPods control and audio drivers and changes the PC's Bluetooth vendor identity. USB dongles do not need this.">
        <!-- Earlier ZIP releases always installed drivers. MSI upgrades migrate feature states. -->
        <Level Value="1" Condition="EXISTINGINSTALL=&quot;zip&quot; AND (NOT OWNEDDRIVERS OR OWNEDDRIVERS=&quot;#1&quot;)" />
        <ComponentRef Id="DriversMarker" />
        <Feature Id="MicAcx" Title="ACX microphone driver" Level="2" AllowAbsent="no" InstallDefault="followParent"
                 Description="The hardened microphone driver for this Windows 11 experimental build.">
          <Level Value="0" Condition="OSBUILD &lt; 22621" />
          <ComponentRef Id="MicAcxMarker" />
        </Feature>
      </Feature>
      <Feature Id="Desktop" Title="Desktop shortcut" Description="An NTPods shortcut on the desktop.">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
      <Feature Id="Startup" Title="Start with Windows" Level="2"
               Description="Start NTPods in the tray after a new installation. Upgrades keep your current app setting.">
        <ComponentRef Id="StartWithWindows" />
      </Feature>
    </Feature>

    <!-- msi-setup.ps1 actions run elevated as SYSTEM. -->
    <!-- Folder properties end in "\", which would escape the closing quote on the
         command line, hence the trailing "." -->

    <!-- Capture the current choice before the old MSI can remove its Run values. -->
    <SetProperty Action="SetStartupExpectedApp" Id="STARTUPAPPEXPECTED" Sequence="execute" After="CostFinalize"
                 Value="&quot;[INSTALLFOLDER]winui\ntpods-winui.exe&quot; --tray" />
    <SetProperty Action="SetStartupExpectedDaemon" Id="STARTUPDAEMONEXPECTED" Sequence="execute" After="SetStartupExpectedApp"
                 Value="&quot;[INSTALLFOLDER]ntpodsd.exe&quot;" />
    <SetProperty Action="SetStartupDefault" Id="STARTUPMODE" Sequence="execute" After="SetStartupExpectedDaemon" Value="off" />
    <SetProperty Action="SetStartupFresh" Id="STARTUPMODE" Sequence="execute" After="SetStartupDefault" Value="on"
                 Condition="NOT (Installed OR WIX_UPGRADE_DETECTED OR EXISTINGINSTALL) AND (&amp;Startup=3)" />
    <SetProperty Action="SetStartupExisting" Id="STARTUPMODE" Sequence="execute" After="SetStartupFresh" Value="on"
                 Condition="(Installed OR WIX_UPGRADE_DETECTED OR EXISTINGINSTALL) AND STARTUPAPP ~= STARTUPAPPEXPECTED AND STARTUPDAEMON ~= STARTUPDAEMONEXPECTED" />

    <!-- Save ownership before major-upgrade removal deletes the old feature marker. -->
    <SetProperty Action="RememberDriverOwnership" Id="OwnsDrivers" Sequence="execute" After="SetStartupExisting" Value="1"
                 Condition="(!Drivers=3) OR OWNEDDRIVERS=&quot;#1&quot; OR OLDMSIDRIVERS=&quot;#1&quot; OR (EXISTINGINSTALL=&quot;zip&quot; AND NOT OWNEDDRIVERS)" />
    <SetProperty Action="SetDriverOwnershipArgs" Id="DriverOwnershipArgs" Sequence="execute" After="RememberDriverOwnership" Value="-PreserveDriverOwnership"
                 Condition="OwnsDrivers=1" />
    <SetProperty Action="SetDriverInstallArgs" Id="DriverInstallArgs" Sequence="execute" After="SetDriverOwnershipArgs" Value="-Drivers"
                 Condition="(&amp;Drivers=3) AND NOT (APPONLYUPGRADE=1 AND WIX_UPGRADE_DETECTED)" />
    <SetProperty Action="SetDriverRemoveArgs" Id="DriverRemoveArgs" Sequence="execute" After="SetDriverInstallArgs" Value="-Drivers"
                 Condition="OwnsDrivers=1" />
    <SetProperty Action="SetInstallOwnershipDefault" Id="InstallDriverOwnership" Sequence="execute" After="SetDriverRemoveArgs" Value="0" />
    <SetProperty Action="SetInstallOwnership" Id="InstallDriverOwnership" Sequence="execute" After="SetInstallOwnershipDefault" Value="1"
                 Condition="(&amp;Drivers=3) OR OwnsDrivers=1" />

    <SetProperty Action="SetMicAcx" Id="MICDRIVER" Sequence="execute" Before="SetNTPodsInstallDrv"
                 Condition="&amp;MicAcx=3" Value="acx" />
    <SetProperty Action="SetMicDefault" Id="MICDRIVER" Sequence="execute" Before="SetNTPodsInstallDrv"
                 Condition="NOT (&amp;MicAcx=3)" Value="acx" />
    <SetProperty Action="SetNTPodsInstallDrv" Id="NTPodsInstall" Sequence="execute" Before="NTPodsInstall"
                 Condition="(&amp;Drivers=3) AND NOT (APPONLYUPGRADE=1 AND WIX_UPGRADE_DETECTED)" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action install -TransactionId &quot;[DriverTransaction]&quot; -UserSid [UserSID] -LocalAppData &quot;[LocalAppDataFolder].&quot; -AppData &quot;[AppDataFolder].&quot; -Drivers -MicDriver [MICDRIVER] -StartupMode [STARTUPMODE] [DriverOwnershipArgs]" />
    <SetProperty Action="SetNTPodsInstall" Id="NTPodsInstall" Sequence="execute" Before="NTPodsInstall"
                 Condition="NOT (&amp;Drivers=3) OR (APPONLYUPGRADE=1 AND WIX_UPGRADE_DETECTED)" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action install -TransactionId &quot;[DriverTransaction]&quot; -UserSid [UserSID] -LocalAppData &quot;[LocalAppDataFolder].&quot; -AppData &quot;[AppDataFolder].&quot; -StartupMode [STARTUPMODE] [DriverOwnershipArgs]" />
    <SetProperty Id="NTPodsStop" Sequence="execute" Before="NTPodsStop" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action stop" />
    <SetProperty Action="CaptureDriverTransaction" Id="DriverTransaction" Sequence="execute" Before="NTPodsPreflight" Value="[ProductCode]|[Date]|[Time]" />
    <SetProperty Id="WixQuietExecCmdLine" Sequence="execute" Before="NTPodsPreflight" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -EncodedCommand $(PreflightCommand)" />
    <SetProperty Action="SetRollbackExisting" Id="NTPodsRollback" Sequence="execute" Before="NTPodsRollback" Condition="Installed OR WIX_UPGRADE_DETECTED OR EXISTINGINSTALL" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action rollback -TransactionId &quot;[DriverTransaction]&quot; -UserSid [UserSID] -PreserveExisting [DriverInstallArgs]" />
    <SetProperty Action="SetRollbackFresh" Id="NTPodsRollback" Sequence="execute" Before="NTPodsRollback" Condition="NOT (Installed OR WIX_UPGRADE_DETECTED OR EXISTINGINSTALL)" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action rollback -TransactionId &quot;[DriverTransaction]&quot; -UserSid [UserSID] [DriverInstallArgs]" />
    <SetProperty Id="NTPodsCommit" Sequence="execute" Before="NTPodsCommit" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action commit -TransactionId &quot;[DriverTransaction]&quot; [DriverInstallArgs]" />
    <SetProperty Id="NTPodsRemoveDrivers" Sequence="execute" Before="NTPodsRemoveDrivers" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action remove-drivers -TransactionId &quot;[DriverTransaction]&quot;" />
    <SetProperty Id="NTPodsRemoveDriversRollback" Sequence="execute" Before="NTPodsRemoveDriversRollback" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action undo-remove-drivers -TransactionId &quot;[DriverTransaction]&quot;" />
    <SetProperty Id="NTPodsRemoveDriversCommit" Sequence="execute" Before="NTPodsRemoveDriversCommit" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action finish-remove-drivers -TransactionId &quot;[DriverTransaction]&quot;" />
    <SetProperty Id="NTPodsUninstall" Sequence="execute" Before="NTPodsUninstall" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action uninstall -TransactionId &quot;[DriverTransaction]&quot; -UserSid [UserSID] -LocalAppData &quot;[LocalAppDataFolder].&quot; -AppData &quot;[AppDataFolder].&quot;" />
    <SetProperty Id="NTPodsIdentityRemoveRollback" Sequence="execute" Before="NTPodsIdentityRemoveRollback" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action undo-remove -TransactionId &quot;[DriverTransaction]&quot;" />
    <SetProperty Id="NTPodsIdentityRemoveCommit" Sequence="execute" Before="NTPodsIdentityRemoveCommit" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[CommonAppDataFolder]NTPods\identity-removal\msi-setup.ps1&quot; -Action finish-remove -TransactionId &quot;[DriverTransaction]&quot; -UserSid &quot;[INSTALLEDUSERSID]&quot; [DriverRemoveArgs]" />

    <CustomAction Id="NTPodsInstall" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="NTPodsPreflight" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="immediate" Return="check" />
    <CustomAction Id="NTPodsStop" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="NTPodsRollback" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="NTPodsCommit" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="commit" Impersonate="no" Return="ignore" />
    <CustomAction Id="NTPodsRemoveDrivers" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="NTPodsRemoveDriversRollback" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="NTPodsRemoveDriversCommit" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="commit" Impersonate="no" Return="ignore" />
    <CustomAction Id="NTPodsUninstall" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="NTPodsIdentityRemoveRollback" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="NTPodsIdentityRemoveCommit" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="commit" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Stop the installed copy before RemoveFiles deletes its shutdown helper. -->
      <!-- Embedded: validate the old install and finish microphone shutdown before its uninstaller runs. -->
      <Custom Action="RequireDriverTestMode" Before="NTPodsPreflight"
              Condition="NOT (REMOVE~=&quot;ALL&quot;) AND (&amp;Drivers=3) AND NOT (APPONLYUPGRADE=1 AND WIX_UPGRADE_DETECTED) AND NOT (BOOTOPTIONS ~&gt;&lt; &quot;TESTSIGNING&quot;)" />
      <Custom Action="NTPodsPreflight" Before="InstallValidate" />
      <Custom Action="NTPodsStop" Before="RemoveFiles" Condition="Installed" />
      <Custom Action="NTPodsRemoveDriversRollback" After="NTPodsStop"
              Condition="(((&amp;Drivers=2) AND (!Drivers=3)) OR ((REMOVE~=&quot;ALL&quot;) AND OwnsDrivers=1)) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="NTPodsRemoveDrivers" After="NTPodsRemoveDriversRollback"
              Condition="(((&amp;Drivers=2) AND (!Drivers=3)) OR ((REMOVE~=&quot;ALL&quot;) AND OwnsDrivers=1)) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="NTPodsRemoveDriversCommit" After="NTPodsRemoveDrivers"
              Condition="(&amp;Drivers=2) AND (!Drivers=3) AND NOT (REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="NTPodsIdentityRemoveRollback" After="NTPodsRemoveDriversCommit"
              Condition="(REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="NTPodsUninstall" After="NTPodsIdentityRemoveRollback"
              Condition="(REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="NTPodsIdentityRemoveCommit" After="NTPodsUninstall"
              Condition="(REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="NTPodsRollback" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="NTPodsInstall" After="NTPodsRollback" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <Custom Action="NTPodsCommit" After="NTPodsInstall" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <ScheduleReboot After="InstallFinalize" Condition="NOT UPGRADINGPRODUCTCODE AND (((&amp;Drivers=2) AND (!Drivers=3)) OR ((REMOVE~=&quot;ALL&quot;) AND OwnsDrivers=1) OR (NOT (REMOVE~=&quot;ALL&quot;) AND (&amp;Drivers=3) AND NOT (APPONLYUPGRADE=1 AND WIX_UPGRADE_DETECTED)))" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
  </Package>
</Wix>
