<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NTPods.WinUI.Controls.FeaturesCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="FeatureRoot">
        <TextBlock Text="{Binding [FeaturesTitle_Text], Source={StaticResource Loc}}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel x:Name="FeatureRows">
                <Grid x:Name="ConvAwarenessRow" Padding="20,16" ColumnSpacing="16" MinHeight="64">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [FeatureCaSwitch_Header], Source={StaticResource Loc}}" TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="ConvAwarenessSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding [FeatureCaSwitch_Header], Source={StaticResource Loc}}" Toggled="ConvAwareness_Toggled" />
                </Grid>
                <Border x:Name="AdaptiveVolumeDivider" Style="{StaticResource InsetDivider}" />
                <Grid x:Name="AdaptiveVolumeRow" Padding="20,16" ColumnSpacing="16" MinHeight="64">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [FeatureAvSwitch_Header], Source={StaticResource Loc}}" TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="AdaptiveVolumeSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding [FeatureAvSwitch_Header], Source={StaticResource Loc}}" Toggled="AdaptiveVolume_Toggled" />
                </Grid>
                <Border x:Name="AllowOffDivider" Style="{StaticResource InsetDivider}" />
                <Grid x:Name="AllowOffRow" Padding="20,16" ColumnSpacing="16" MinHeight="64">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [FeatureAllowOffSwitch_Header], Source={StaticResource Loc}}" TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="AllowOffSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding [FeatureAllowOffSwitch_Header], Source={StaticResource Loc}}" Toggled="AllowOff_Toggled" />
                </Grid>
            </StackPanel>
        </Border>
        <Expander x:Name="ConversationVolumeExpander" Style="{StaticResource GroupExpander}" Margin="0,12,0,0"
                  Header="{Binding [ConversationVolume_Title], Source={StaticResource Loc}}" Visibility="Collapsed">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding [ConversationVolume_Help], Source={StaticResource Loc}}"
                           Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                <StackPanel x:Name="ConversationPolicyControls" Spacing="12" Visibility="Collapsed">
                    <ComboBox x:Name="ConversationMode" HorizontalAlignment="Stretch" SelectionChanged="ConversationMode_SelectionChanged"
                              AutomationProperties.Name="{Binding [ConversationPolicy_Mode], Source={StaticResource Loc}}">
                        <ComboBoxItem Content="{Binding [ConversationPolicy_Absolute], Source={StaticResource Loc}}" />
                        <ComboBoxItem Content="{Binding [ConversationPolicy_Relative], Source={StaticResource Loc}}" />
                    </ComboBox>
                </StackPanel>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Slider x:Name="ConversationVolumeSlider" Minimum="0" Maximum="100" StepFrequency="1"
                            AutomationProperties.Name="{Binding [ConversationVolume_Title], Source={StaticResource Loc}}"
                            AutomationProperties.HelpText="{Binding [ConversationVolume_Help], Source={StaticResource Loc}}"
                            ValueChanged="ConversationVolume_ValueChanged" />
                    <TextBlock x:Name="ConversationVolumeText" Grid.Column="1" MinWidth="44" VerticalAlignment="Center"
                               TextAlignment="Right" Foreground="{ThemeResource AppleSecondaryBrush}" />
                </Grid>
                <StackPanel x:Name="ConversationSecondControls" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="{Binding [ConversationPolicy_Second], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Slider x:Name="ConversationSecondSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                AutomationProperties.Name="{Binding [ConversationPolicy_Second], Source={StaticResource Loc}}" ValueChanged="ConversationSecond_ValueChanged" />
                        <TextBlock x:Name="ConversationSecondText" Grid.Column="1" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AppleSecondaryBrush}" />
                    </Grid>
                    <Grid ColumnSpacing="16" MinHeight="48">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [ConversationPolicy_Pause], Source={StaticResource Loc}}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="ConversationPause" Grid.Column="1" Style="{StaticResource SettingToggle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding [ConversationPolicy_Pause], Source={StaticResource Loc}}" Toggled="ConversationPause_Toggled" />
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="ConversationVolumeError" Visibility="Collapsed" TextWrapping="Wrap" FontSize="14"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding [ConversationVolume_Error], Source={StaticResource Loc}}" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
