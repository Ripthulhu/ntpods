<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NTPods.WinUI.Controls.DeviceSettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DeviceLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DeviceStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource AppleSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding [DeviceControls_Title], Source={StaticResource Loc}}" Style="{StaticResource SectionTitle}" />
        <StackPanel Spacing="16">
            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="{Binding [DeviceControls_ErrorTitle], Source={StaticResource Loc}}" />
            <Border x:Name="AutoPauseRow" Style="{StaticResource Card}" Padding="20,16">
                <Grid ColumnSpacing="16" MinHeight="36">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="AutoPauseLabel" Text="{Binding [DeviceControls_AutoPause], Source={StaticResource Loc}}"
                               TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="AutoPauseSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding [DeviceControls_AutoPause], Source={StaticResource Loc}}" Toggled="AutoPause_Toggled" />
                </Grid>
            </Border>
            <Expander x:Name="PlaybackExpander" Style="{StaticResource GroupExpander}" Header="{Binding [DeviceControls_Playback], Source={StaticResource Loc}}">
                <StackPanel>
                    <StackPanel x:Name="PlaybackRouteRow" Spacing="8" Margin="0,14" Visibility="Collapsed">
                        <TextBlock Text="{Binding [Playback_Title], Source={StaticResource Loc}}" Style="{StaticResource DeviceLabel}" />
                        <ComboBox x:Name="PlaybackPicker" HorizontalAlignment="Stretch" SelectionChanged="Playback_Changed"
                                  AutomationProperties.Name="{Binding [Playback_Title], Source={StaticResource Loc}}">
                            <ComboBoxItem Tag="windows" Content="{Binding [Playback_Windows], Source={StaticResource Loc}}" />
                            <ComboBoxItem Tag="aac" Content="AAC" />
                            <ComboBoxItem Tag="aac_eld" Content="AAC-ELD" />
                        </ComboBox>
                        <TextBlock x:Name="PlaybackRoutingHint" Text="{Binding [Playback_RoutingHint], Source={StaticResource Loc}}"
                                   Style="{StaticResource DeviceStatus}" Visibility="Collapsed" />
                        <TextBlock x:Name="PlaybackError" Style="{StaticResource DeviceStatus}" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="PlaybackRetry" Content="{Binding [Playback_Retry], Source={StaticResource Loc}}"
                                Click="PlaybackRetry_Click" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="PlaybackPanel" />
                </StackPanel>
            </Expander>
            <Expander x:Name="StemExpander" Style="{StaticResource GroupExpander}" Header="{Binding [DeviceControls_Stem], Source={StaticResource Loc}}">
                <StackPanel x:Name="StemPanel" />
            </Expander>
            <Expander x:Name="ComfortExpander" Style="{StaticResource GroupExpander}" Header="{Binding [DeviceControls_Comfort], Source={StaticResource Loc}}">
                <StackPanel>
                    <StackPanel x:Name="ComfortPanel" />
                    <Border x:Name="LoudSoundReductionDivider" Style="{StaticResource InsetDivider}" Margin="0" Visibility="Collapsed" />
                    <Grid x:Name="LoudSoundReductionRow" Margin="0,14" ColumnSpacing="16" MinHeight="36" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding [LoudSoundReduction_Title], Source={StaticResource Loc}}" Style="{StaticResource DeviceLabel}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="LoudSoundReductionSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding [LoudSoundReduction_Title], Source={StaticResource Loc}}" Toggled="LoudSoundReduction_Toggled" />
                        <TextBlock x:Name="LoudSoundReductionError" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="Collapsed"
                                   Style="{StaticResource DeviceStatus}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </StackPanel>
            </Expander>
            <StackPanel Spacing="8" Margin="16,0">
                <Button x:Name="RefreshButton" Content="{Binding [DeviceControls_Refresh], Source={StaticResource Loc}}" Click="Refresh_Click" />
                <TextBlock Text="{Binding [DeviceControls_RefreshHint], Source={StaticResource Loc}}" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
