<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NTPods.WinUI.Controls.NoiseControlCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SelectionForeground" Color="{ThemeResource AppleSelectedForegroundColor}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource AppleHoverColor}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource AppleHoverColor}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource AppleSelectedForegroundColor}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource AppleSelectedForegroundColor}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource AppleSelectedForegroundColor}" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding [NoiseControlTitle_Text], Source={StaticResource Loc}}" Style="{StaticResource SectionTitle}" />
        <Grid>
            <Border Background="{ThemeResource AppleTrackBrush}" CornerRadius="30" IsHitTestVisible="False" />
            <Grid x:Name="Track" Height="54" Margin="4" SizeChanged="Track_SizeChanged">
                <Grid x:Name="ModeGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="OffColumn" Width="0" />
                        <ColumnDefinition x:Name="TransparencyColumn" Width="*" />
                        <ColumnDefinition x:Name="AdaptiveColumn" Width="*" />
                        <ColumnDefinition x:Name="AncColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="AncOffBtn" Grid.Column="0" Tag="1"
                                  Style="{StaticResource ListeningModeButton}" Click="Anc_Click"
                                  AutomationProperties.Name="{Binding [Anc_Off], Source={StaticResource Loc}}">
                        <BitmapIcon x:Name="OffIcon" UriSource="ms-appx:///Assets/ic_noise_cancellation.png" ShowAsMonochrome="True" Width="28" Height="28" />
                    </ToggleButton>
                    <ToggleButton x:Name="AncTransBtn" Grid.Column="1" Tag="3"
                                  Style="{StaticResource ListeningModeButton}" Click="Anc_Click"
                                  AutomationProperties.Name="{Binding [Anc_Transparency], Source={StaticResource Loc}}">
                        <BitmapIcon x:Name="TransparencyIcon" UriSource="ms-appx:///Assets/ic_transparency.png" ShowAsMonochrome="True" Width="28" Height="28" />
                    </ToggleButton>
                    <ToggleButton x:Name="AncAdaptiveBtn" Grid.Column="2" Tag="4"
                                  Style="{StaticResource ListeningModeButton}" Click="Anc_Click"
                                  AutomationProperties.Name="{Binding [Anc_Adaptive], Source={StaticResource Loc}}">
                        <BitmapIcon x:Name="AdaptiveIcon" UriSource="ms-appx:///Assets/ic_adaptive.png" ShowAsMonochrome="True" Width="28" Height="28" />
                    </ToggleButton>
                    <Grid x:Name="AdaptiveRail" Grid.Column="2" Visibility="Collapsed">
                        <Border x:Name="AdaptiveSurface" CornerRadius="27" Tapped="AdaptiveRail_Tapped" />
                        <Grid Margin="16,0" IsHitTestVisible="False">
                            <Ellipse x:Name="MinimumMarker" Width="13" Height="13" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeDashArray="1,2" HorizontalAlignment="Left" />
                            <Ellipse x:Name="MaximumMarker" Width="13" Height="13" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" />
                        </Grid>
                        <!-- The shared thumb renders this native slider's value; its focus ring remains visible below. -->
                        <Slider x:Name="StrengthSlider" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10"
                                MinWidth="0" Opacity="0" IsHitTestVisible="False"
                                AutomationProperties.Name="{Binding [AdaptiveNoiseTitle_Text], Source={StaticResource Loc}}"
                                ValueChanged="Strength_Changed" GotFocus="Strength_GotFocus" LostFocus="Strength_LostFocus" />
                        <Border x:Name="AdaptiveFocusRing" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="2" CornerRadius="27"
                                Margin="1" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ToggleButton x:Name="AncNcBtn" Grid.Column="3" Tag="2"
                                  Style="{StaticResource ListeningModeButton}" Click="Anc_Click"
                                  AutomationProperties.Name="{Binding [Anc_NoiseCancellation], Source={StaticResource Loc}}">
                        <BitmapIcon x:Name="AncIcon" UriSource="ms-appx:///Assets/ic_noise_cancellation.png" ShowAsMonochrome="True" Width="28" Height="28" />
                    </ToggleButton>
                </Grid>
                <Grid x:Name="GlassHost" IsHitTestVisible="False" />
                <Canvas>
                    <Grid x:Name="Selection" Height="54" Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SelectionTransform" />
                        </Grid.RenderTransform>
                        <Grid x:Name="SelectedArtwork" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SelectionScale" />
                            </Grid.RenderTransform>
                            <Border x:Name="SelectionFallback" Background="{ThemeResource AppleSelectedBrush}"
                                    BorderBrush="{ThemeResource AppleDividerBrush}" BorderThickness="1" CornerRadius="27" />
                            <BitmapIcon x:Name="SelectedTransparencyIcon" UriSource="ms-appx:///Assets/ic_transparency.png"
                                        Width="28" Height="28" ShowAsMonochrome="True"
                                        Foreground="{StaticResource SelectionForeground}" />
                            <BitmapIcon x:Name="SelectedAdaptiveIcon" UriSource="ms-appx:///Assets/ic_adaptive.png"
                                        Width="28" Height="28" ShowAsMonochrome="True"
                                        Foreground="{StaticResource SelectionForeground}" />
                            <BitmapIcon x:Name="SelectedAncIcon" UriSource="ms-appx:///Assets/ic_noise_cancellation.png"
                                        Width="28" Height="28" ShowAsMonochrome="True"
                                        Foreground="{StaticResource SelectionForeground}" />
                        </Grid>
                        <Thumb x:Name="SelectionThumb" IsTabStop="False" AutomationProperties.AccessibilityView="Raw"
                               DragStarted="Selection_DragStarted" DragDelta="Selection_DragDelta" DragCompleted="Selection_DragCompleted">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" CornerRadius="27" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Border x:Name="ModeFocusRing" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                BorderThickness="2" CornerRadius="27" Margin="1" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </Canvas>
            </Grid>
        </Grid>
        <Grid Margin="4,8,4,0" IsHitTestVisible="False">
            <TextBlock x:Name="OffLabel" Text="{Binding [Anc_Off], Source={StaticResource Loc}}"
                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="2,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0"
                       AutomationProperties.AccessibilityView="Raw">
                <TextBlock.RenderTransform><TranslateTransform x:Name="OffLabelTransform" /></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="TransparencyLabel" Text="{Binding [Anc_Transparency], Source={StaticResource Loc}}"
                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="2,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock.RenderTransform><TranslateTransform x:Name="TransparencyLabelTransform" /></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="AdaptiveLabel" Text="{Binding [Anc_Adaptive], Source={StaticResource Loc}}"
                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="2,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock.RenderTransform><TranslateTransform x:Name="AdaptiveLabelTransform" /></TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="AncLabel" Text="{Binding [Anc_NoiseCancellation], Source={StaticResource Loc}}"
                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="2,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock.RenderTransform><TranslateTransform x:Name="AncLabelTransform" /></TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
        <TextBlock x:Name="AncModeLabel" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Margin="16,8,16,0" FontSize="13" Visibility="Collapsed"
                   Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
