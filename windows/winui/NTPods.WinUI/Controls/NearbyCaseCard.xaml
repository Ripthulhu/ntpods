<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NTPods.WinUI.Controls.NearbyCaseCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander x:Name="Panel" Style="{StaticResource GroupExpander}"
              Header="{Binding [NearbyCase_Title], Source={StaticResource Loc}}" Collapsed="Panel_Collapsed">
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding [NearbyCase_Description], Source={StaticResource Loc}}"
                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}" />
            <Button x:Name="ReadButton" HorizontalAlignment="Stretch" Click="Read_Click">
                <TextBlock x:Name="ReadLabel" TextWrapping="Wrap" />
            </Button>
            <StackPanel x:Name="Results" Spacing="16" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding [NearbyCase_Protocol], Source={StaticResource Loc}}"
                               FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}" />
                    <TextBlock x:Name="ProtocolValue" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource InsetDivider}" Margin="0" />
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding [NearbyCase_Firmware], Source={StaticResource Loc}}"
                               FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}" />
                    <TextBlock x:Name="FirmwareValue" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource InsetDivider}" Margin="0" />
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding [NearbyCase_Capabilities], Source={StaticResource Loc}}"
                               FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}" />
                    <TextBlock x:Name="CapabilitiesValue" FontSize="16" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding [NearbyCase_NearbyOnly], Source={StaticResource Loc}}"
                           FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Expander>
</UserControl>
