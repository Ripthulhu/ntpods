<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NTPods.WinUI.Controls.VolumeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding [VolumeTitle_Text], Source={StaticResource Loc}}" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="MuteToggle" Click="Mute_Click" Width="36" Height="36" Padding="0"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding [MuteToggle_Content], Source={StaticResource Loc}}"
                              ToolTipService.ToolTip="{Binding [MuteToggle_Content], Source={StaticResource Loc}}">
                    <FontIcon Glyph="&#xE767;" FontSize="18" />
                </ToggleButton>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding [VolumeTitle_Text], Source={StaticResource Loc}}"
                        ValueChanged="Volume_ValueChanged" />
                <TextBlock x:Name="VolumeText" Grid.Column="2" Text="—" MinWidth="48" FontSize="16"
                           VerticalAlignment="Center" TextAlignment="Right" Foreground="{ThemeResource AppleSecondaryBrush}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
