<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NTPods.WinUI.Controls.MultipointCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ipc="using:NTPods.WinUI.Ipc"
    mc:Ignorable="d">

    <Expander Style="{StaticResource GroupExpander}" IsExpanded="False">
        <Expander.Header>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [MultipointTitle_Text], Source={StaticResource Loc}}" FontSize="16" />
                <TextBlock x:Name="SummaryText" FontSize="13"
                           Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="16">
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ipc:ConnectedDevice">
                        <Grid Margin="0,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="{x:Bind Glyph}"
                                      FontSize="20"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Name}" FontSize="16" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Address}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AppleSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding [Multipoint_Hint], Source={StaticResource Loc}}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AppleSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>
    </Expander>
</UserControl>
