<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NTPods.WinUI.Controls.HearingAidCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Expander x:Name="HearingExpander" Style="{StaticResource GroupExpander}" IsExpanded="False">
        <Expander.Header>
            <TextBlock Text="{Binding [HearingAidTitle_Text], Source={StaticResource Loc}}"
                       FontSize="16" />
        </Expander.Header>
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding [HearingAidSubtitle_Text], Source={StaticResource Loc}}"
                       Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="13"
                       TextWrapping="Wrap" />
            <InfoBar Title="{Binding [HearingAidWarning_Title], Source={StaticResource Loc}}"
                     Message="{Binding [HearingAidWarning_Message], Source={StaticResource Loc}}"
                     Severity="Warning" IsOpen="True" IsClosable="False" />

            <Button x:Name="ReadButton" HorizontalAlignment="Stretch" Click="Read_Click">
                <TextBlock Text="{Binding [Transparency_Read], Source={StaticResource Loc}}" TextWrapping="Wrap" />
            </Button>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [HearingAidSwitch_Header], Source={StaticResource Loc}}"
                           FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="EnableSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}"
                              AutomationProperties.Name="{Binding [HearingAidSwitch_Header], Source={StaticResource Loc}}"
                              Toggled="Enable_Toggled" />
            </Grid>

            <TextBlock x:Name="ErrorText" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="DisableButton" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="Disable_Click">
                <TextBlock Text="{Binding [HearingAid_TurnOff], Source={StaticResource Loc}}" TextWrapping="Wrap" />
            </Button>

            <!-- Per-person audiogram (hearing loss, dB HL). Rows built in code-behind. -->
            <TextBlock Text="{Binding [HearingAidAudiogram_Header], Source={StaticResource Loc}}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource AppleSecondaryBrush}"
                       Margin="0,4,0,0" />
            <Grid x:Name="AudiogramGrid" ColumnSpacing="10" RowSpacing="4" />

            <Slider x:Name="AmpSlider" Minimum="0" Maximum="100" Value="50"
                    Header="{Binding [HearingAidAmp_Header], Source={StaticResource Loc}}"
                    AutomationProperties.Name="{Binding [HearingAidAmp_Header], Source={StaticResource Loc}}"
                    ValueChanged="Settings_Changed" IsEnabled="False" />

            <Slider x:Name="BalanceSlider" Minimum="-100" Maximum="100" Value="0"
                    Header="{Binding [HearingAidBalance_Header], Source={StaticResource Loc}}"
                    AutomationProperties.Name="{Binding [HearingAidBalance_Header], Source={StaticResource Loc}}"
                    ValueChanged="Settings_Changed" IsEnabled="False" />

            <Slider x:Name="ToneSlider" Minimum="-100" Maximum="100" Value="0"
                    Header="{Binding [HearingAidTone_Header], Source={StaticResource Loc}}"
                    AutomationProperties.Name="{Binding [HearingAidTone_Header], Source={StaticResource Loc}}"
                    ValueChanged="Settings_Changed" IsEnabled="False" />

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [HearingAidConvBoost_Header], Source={StaticResource Loc}}"
                           FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="ConvBoostSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}"
                              AutomationProperties.Name="{Binding [HearingAidConvBoost_Header], Source={StaticResource Loc}}"
                              IsEnabled="False" Toggled="ConvBoost_Toggled" />
            </Grid>
        </StackPanel>
    </Expander>
</UserControl>
