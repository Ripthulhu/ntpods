<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NTPods.WinUI.Controls.DeviceHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Stretch">
            <Image x:Name="DeviceImage" Width="80" Height="80" Stretch="Uniform" Visibility="Collapsed" />
            <Grid x:Name="NameView">
                <TextBlock x:Name="DeviceName" Text="NTPods" FontSize="24" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Grid x:Name="NameEdit" Visibility="Collapsed" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" MaxLength="64" KeyDown="NameBox_KeyDown"
                         AutomationProperties.Name="{Binding [DeviceName_Label], Source={StaticResource Loc}}" />
                <Button x:Name="SubmitBtn" Grid.Column="1" Click="Submit_Click" Padding="8"
                        AutomationProperties.Name="{Binding [Action_Save], Source={StaticResource Loc}}">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                </Button>
                <Button x:Name="CancelBtn" Grid.Column="2" Click="Cancel_Click" Padding="8"
                        AutomationProperties.Name="{Binding [Action_Cancel], Source={StaticResource Loc}}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{ThemeResource AppleSecondaryBrush}" />
                <TextBlock x:Name="StatusText" Text="Connecting…" FontSize="13" TextWrapping="Wrap"
                           Foreground="{ThemeResource AppleSecondaryBrush}" />
                <HyperlinkButton x:Name="ConnectButton" Padding="0" Visibility="Collapsed" Click="Connect_Click"
                                 Content="{Binding [HeaderConnectBtn_Content], Source={StaticResource Loc}}" />
            </StackPanel>
        </StackPanel>
        <Button x:Name="MoreButton" Grid.Column="2" Width="40" Height="40" Padding="0" VerticalAlignment="Top"
                Style="{StaticResource QuietButton}"
                AutomationProperties.Name="{Binding [DeviceActions_Label], Source={StaticResource Loc}}"
                ToolTipService.ToolTip="{Binding [DeviceActions_Label], Source={StaticResource Loc}}">
            <FontIcon Glyph="&#xE712;" FontSize="18" />
            <Button.Flyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="RenameBtn" Click="Rename_Click" Visibility="Collapsed"
                                    Text="{Binding [Action_Rename], Source={StaticResource Loc}}" />
                    <MenuFlyoutItem x:Name="RepairButton" Click="Repair_Click" Visibility="Collapsed"
                                    Text="{Binding [HeaderRepairBtn_Text], Source={StaticResource Loc}}" />
                    <MenuFlyoutItem x:Name="RebuildAudioButton" Click="RebuildAudio_Click" Visibility="Collapsed"
                                    Text="{Binding [HeaderRebuildAudioBtn_Text], Source={StaticResource Loc}}" />
                    <MenuFlyoutItem x:Name="DisconnectButton" Click="Disconnect_Click" Visibility="Collapsed"
                                    Text="{Binding [HeaderDisconnectBtn_Text], Source={StaticResource Loc}}" />
                    <MenuFlyoutSeparator x:Name="DeviceActionsSeparator" Visibility="Collapsed" />
                    <MenuFlyoutItem Click="Settings_Click" Text="{Binding [SettingsTitle_Text], Source={StaticResource Loc}}">
                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Setting" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>
        <TeachingTip x:Name="RenameHint" IsLightDismissEnabled="True" PreferredPlacement="Bottom" />
    </Grid>
</UserControl>
