<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NTPods.WinUI.Controls.DeviceHeader" FontFamily="{StaticResource AppleBodyFont}">
    <Grid ColumnSpacing="12" Padding="16,8,16,0" MinHeight="84">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Spacing="0" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <Image x:Name="DeviceImage" Width="80" Height="80" Stretch="Uniform" Visibility="Collapsed" />
            <Grid x:Name="NameView" MinHeight="32">
                <TextBlock x:Name="DeviceName" Text="NTPods" FontSize="22" FontWeight="ExtraBold" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=DeviceName}" />
            </Grid>
            <Grid x:Name="NameEdit" Visibility="Collapsed" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" MaxLength="64" KeyDown="NameBox_KeyDown" AutomationProperties.Name="{Binding [DeviceName_Label], Source={StaticResource Loc}}" />
                <Button x:Name="SubmitBtn" Grid.Column="1" Click="Submit_Click" Padding="8" AutomationProperties.Name="{Binding [Action_Save], Source={StaticResource Loc}}">
                    <FontIcon Glyph="" FontSize="14" />
                </Button>
                <Button x:Name="CancelBtn" Grid.Column="2" Click="Cancel_Click" Padding="8" AutomationProperties.Name="{Binding [Action_Cancel], Source={StaticResource Loc}}">
                    <FontIcon Glyph="" FontSize="14" />
                </Button>
            </Grid>
            <Grid x:Name="StatusRow" MinHeight="44" ColumnSpacing="7" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource AppleSecondaryBrush}" />
                <Ellipse x:Name="ConnectedDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource AppleGreenBrush}" Visibility="Collapsed" />
                <Ellipse x:Name="StaleDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Connecting…" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource AppleSecondaryBrush}" />
                <Button x:Name="ConnectButton" Grid.Column="2" Style="{StaticResource GlassActionButton}"
                        Padding="12,4" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"
                        Click="Connect_Click" Content="{Binding [HeaderConnectBtn_Content], Source={StaticResource Loc}}" />
            </Grid>
        </StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource CircleButton}"
                Click="Settings_Click" AutomationProperties.Name="{Binding [SettingsTitle_Text], Source={StaticResource Loc}}"
                ToolTipService.ToolTip="{Binding [SettingsTitle_Text], Source={StaticResource Loc}}">
            <SymbolIcon Symbol="Setting" />
        </Button>
        <Button x:Name="MoreButton" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource CircleButton}" Visibility="Collapsed" AutomationProperties.Name="{Binding [DeviceActions_Label], Source={StaticResource Loc}}" ToolTipService.ToolTip="{Binding [DeviceActions_Label], Source={StaticResource Loc}}">
            <FontIcon Glyph="" FontSize="18" />
            <Button.Flyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="RenameBtn" Click="Rename_Click" Visibility="Collapsed" Text="{Binding [Action_Rename], Source={StaticResource Loc}}" />
                    <MenuFlyoutItem x:Name="RepairButton" Click="Repair_Click" Visibility="Collapsed" Text="{Binding [HeaderRepairBtn_Text], Source={StaticResource Loc}}" />
                    <MenuFlyoutItem x:Name="RebuildAudioButton" Click="RebuildAudio_Click" Visibility="Collapsed" Text="{Binding [HeaderRebuildAudioBtn_Text], Source={StaticResource Loc}}" />
                    <MenuFlyoutItem x:Name="DisconnectButton" Click="Disconnect_Click" Visibility="Collapsed" Text="{Binding [HeaderDisconnectBtn_Text], Source={StaticResource Loc}}" />
                    <MenuFlyoutSeparator x:Name="DeviceActionsSeparator" Visibility="Collapsed" />
                    <MenuFlyoutItem x:Name="NativePairButton" Click="Pair_Click" Text="{Binding [Pairing_Title], Source={StaticResource Loc}}" />
                    <MenuFlyoutItem Click="Settings_Click" Text="{Binding [SettingsTitle_Text], Source={StaticResource Loc}}">
                        <MenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Setting" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>
        <TeachingTip x:Name="RenameHint" IsLightDismissEnabled="True" PreferredPlacement="Bottom" />
    </Grid>
</UserControl>
