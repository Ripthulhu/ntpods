<UserControl x:Class="NTPods.WinUI.Controls.SpeakerRoomCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <Border Style="{StaticResource Card}" Padding="18,16">
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="{Binding [Room_Title], Source={StaticResource Loc}}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LayoutLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource AppleSecondaryBrush}"/>
                </Grid>
                <Grid>
                <Border CornerRadius="16" x:Name="SceneContainer" Visibility="Collapsed">
                    <Grid x:Name="SceneHost" Height="340"/>
                </Border>
                <StackPanel x:Name="PlanView" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding [Room_Screen], Source={StaticResource Loc}}" HorizontalAlignment="Center" FontSize="12" Foreground="{ThemeResource AppleSecondaryBrush}"/>
                <Canvas x:Name="Map" Height="218" SizeChanged="Map_SizeChanged" Background="Transparent"
                        AutomationProperties.Name="{Binding [Room_Title], Source={StaticResource Loc}}">
                    <Ellipse x:Name="Orbit" Stroke="{ThemeResource AppleDividerBrush}" StrokeThickness="1"/>
                    <Ellipse x:Name="InnerOrbit" Stroke="{ThemeResource AppleDividerBrush}" StrokeThickness="1" StrokeDashArray="3,5"/>
                    <Line x:Name="Meridian" Stroke="{ThemeResource AppleDividerBrush}"/>
                    <Line x:Name="Equator" Stroke="{ThemeResource AppleDividerBrush}"/>
                    <Ellipse x:Name="Head" Width="25" Height="25" Fill="{ThemeResource AppleGroupBrush}" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2"/>
                    <Line x:Name="Heading" Stroke="{ThemeResource NTPodsAccentBrush}" StrokeThickness="4" StrokeEndLineCap="Round"/>
                    <Line x:Name="EarLine" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                </Canvas>
                <TextBlock Text="{Binding [Room_SelectionHint], Source={StaticResource Loc}}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}"/>
                </StackPanel>
                </Grid>
                <Grid x:Name="SceneTools" Visibility="Collapsed" ColumnSpacing="8" Margin="0,3,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SceneHint"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}"/>
                    <Button Grid.Column="1" x:Name="ResetView" VerticalAlignment="Center"
                            Style="{StaticResource QuietButton}" Click="ResetView_Click"
                            Content="{Binding [Room_ViewReset], Source={StaticResource Loc}}"/>
                </Grid>
                <TextBlock x:Name="PoseLabel" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}"/>
                <TextBlock x:Name="ActivityLabel" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}"/>
            </StackPanel>
        </Border>
        <Expander x:Name="Placement" Header="{Binding [Room_Placement], Source={StaticResource Loc}}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" CornerRadius="24">
            <StackPanel Spacing="8" Padding="4">
                <Grid>
                    <TextBlock Text="{Binding [Room_Width], Source={StaticResource Loc}}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WidthValue" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="WidthSlider" Minimum="50" Maximum="500" StepFrequency="1" ValueChanged="Edit_Changed"
                        AutomationProperties.Name="{Binding [Room_Width], Source={StaticResource Loc}}"
                        AutomationProperties.HelpText="{Binding [Room_WidthHelp], Source={StaticResource Loc}}"
                        ToolTipService.ToolTip="{Binding [Room_WidthHelp], Source={StaticResource Loc}}"/>
                <DropDownButton x:Name="Channel" HorizontalAlignment="Stretch">
                    <DropDownButton.Content>
                        <TextBlock x:Name="ChannelLabel" TextWrapping="Wrap"/>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <Flyout>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ChannelChoices" Spacing="2"/>
                            </ScrollViewer>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <StackPanel x:Name="PositionControls" Spacing="4">
                    <Grid><TextBlock Text="{Binding [Room_Azimuth], Source={StaticResource Loc}}"/><TextBlock x:Name="AzValue" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="Az" Minimum="-180" Maximum="180" StepFrequency="1" ValueChanged="Edit_Changed"
                            AutomationProperties.Name="{Binding [Room_Azimuth], Source={StaticResource Loc}}"/>
                    <Grid><TextBlock Text="{Binding [Room_Elevation], Source={StaticResource Loc}}"/><TextBlock x:Name="ElValue" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="El" Minimum="-90" Maximum="90" StepFrequency="1" ValueChanged="Edit_Changed"
                            AutomationProperties.Name="{Binding [Room_Elevation], Source={StaticResource Loc}}"/>
                </StackPanel>
                <StackPanel x:Name="GainControls" Spacing="4">
                    <Grid><TextBlock Text="{Binding [Room_Level], Source={StaticResource Loc}}"/><TextBlock x:Name="GainValue" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="Gain" Minimum="-24" Maximum="0" StepFrequency="1" ValueChanged="Edit_Changed"
                            AutomationProperties.Name="{Binding [Room_Level], Source={StaticResource Loc}}"/>
                </StackPanel>
                <Button Style="{StaticResource QuietButton}" Click="Reset_Click" Content="{Binding [Room_Reset], Source={StaticResource Loc}}"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
