<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NTPods.WinUI.Controls.BatteryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="16" Margin="12,12,12,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel x:Name="LeftCell" Grid.Column="0" Spacing="8">
            <Grid x:Name="LeftArtwork">
                <Image x:Name="LeftImg" Height="126" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,14" />
            </Grid>
            <Grid Width="34" Height="34" HorizontalAlignment="Center">
                <ProgressRing x:Name="LeftBar" IsIndeterminate="False" IsActive="True" Minimum="0" Maximum="100" Value="0"
                              Width="34" Height="34" Foreground="{ThemeResource AppleGreenBrush}"
                              Background="{ThemeResource AppleDividerBrush}"
                              AutomationProperties.Name="{Binding [BatteryLeftLabel_Text], Source={StaticResource Loc}}" />
                <Path x:Name="LeftCharging" Width="10" Height="16" Visibility="Collapsed"
                          Fill="{ThemeResource AppleGreenBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Data="M 8,0 L 0,9 L 4,9 L 2,16 L 10,7 L 6,7 Z" />
            </Grid>
            <TextBlock x:Name="LeftText" Text="—" FontSize="17" TextAlignment="Center" />
            <TextBlock x:Name="LeftLabel" Text="{Binding [BatteryLeftLabel_Text], Source={StaticResource Loc}}" FontSize="12"
                       Foreground="{ThemeResource AppleSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="RightCell" Grid.Column="1" Spacing="8">
            <Grid x:Name="RightArtwork">
                <Image x:Name="RightImg" Height="126" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,14" />
            </Grid>
            <Grid Width="34" Height="34" HorizontalAlignment="Center">
                <ProgressRing x:Name="RightBar" IsIndeterminate="False" IsActive="True" Minimum="0" Maximum="100" Value="0"
                              Width="34" Height="34" Foreground="{ThemeResource AppleGreenBrush}"
                              Background="{ThemeResource AppleDividerBrush}"
                              AutomationProperties.Name="{Binding [BatteryRightLabel_Text], Source={StaticResource Loc}}" />
                <Path x:Name="RightCharging" Width="10" Height="16" Visibility="Collapsed"
                          Fill="{ThemeResource AppleGreenBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Data="M 8,0 L 0,9 L 4,9 L 2,16 L 10,7 L 6,7 Z" />
            </Grid>
            <TextBlock x:Name="RightText" Text="—" FontSize="17" TextAlignment="Center" />
            <TextBlock Text="{Binding [BatteryRightLabel_Text], Source={StaticResource Loc}}" FontSize="12"
                       Foreground="{ThemeResource AppleSecondaryBrush}" TextAlignment="Center" />
        </StackPanel>
        <StackPanel x:Name="CaseCell" Grid.Column="2" Spacing="8">
            <Grid x:Name="CaseArtwork">
                <Image x:Name="CaseImg" Height="126" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,14" />
            </Grid>
            <Grid Width="34" Height="34" HorizontalAlignment="Center">
                <ProgressRing x:Name="CaseBar" IsIndeterminate="False" IsActive="True" Minimum="0" Maximum="100" Value="0"
                              Width="34" Height="34" Foreground="{ThemeResource AppleGreenBrush}"
                              Background="{ThemeResource AppleDividerBrush}"
                              AutomationProperties.Name="{Binding [BatteryCaseLabel_Text], Source={StaticResource Loc}}" />
                <Path x:Name="CaseCharging" Width="10" Height="16" Visibility="Collapsed"
                          Fill="{ThemeResource AppleGreenBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Data="M 8,0 L 0,9 L 4,9 L 2,16 L 10,7 L 6,7 Z" />
            </Grid>
            <TextBlock x:Name="CaseText" Text="—" FontSize="17" TextAlignment="Center" />
            <TextBlock Text="{Binding [BatteryCaseLabel_Text], Source={StaticResource Loc}}" FontSize="12"
                       Foreground="{ThemeResource AppleSecondaryBrush}" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
