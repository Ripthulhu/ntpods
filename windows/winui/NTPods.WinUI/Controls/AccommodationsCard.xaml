<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NTPods.WinUI.Controls.AccommodationsCard">
    <UserControl.Resources><x:Double x:Key="RadioButtonsRowSpacing">0</x:Double></UserControl.Resources>
    <StackPanel Spacing="16">
        <StackPanel Spacing="8">
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="12" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Accommodations_Title], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="MasterSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}" AutomationProperties.Name="{Binding [Accommodations_Title], Source={StaticResource Loc}}" Toggled="Master_Changed" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding [Accommodations_Help], Source={StaticResource Loc}}" FontSize="12" Margin="16,0" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock x:Name="TuningLabel" Text="{Binding [Accommodations_AudioTuning], Source={StaticResource Loc}}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <RadioButtons x:Name="TuningPicker" MaxColumns="1" SelectionChanged="Tuning_Changed" AutomationProperties.Name="{Binding [Accommodations_AudioTuning], Source={StaticResource Loc}}">
                    <RadioButton x:Name="AudiogramChoice" Style="{StaticResource AppleChoiceRow}" Width="{Binding ActualWidth, ElementName=TuningPicker}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding [Accommodations_Audiogram], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource AppleChoiceRow}" Width="{Binding ActualWidth, ElementName=TuningPicker}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding [Accommodations_BalancedTone], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource AppleChoiceRow}" Width="{Binding ActualWidth, ElementName=TuningPicker}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding [Accommodations_VocalRange], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource AppleChoiceRow}" Width="{Binding ActualWidth, ElementName=TuningPicker}" BorderThickness="0">
                        <TextBlock Text="{Binding [Accommodations_Brightness], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" />
                    </RadioButton>
                </RadioButtons>
            </Border>
            <TextBlock x:Name="TuningHelp" FontSize="12" Margin="16,0" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="OptimizationControls" Spacing="4">
            <Border Style="{StaticResource Card}" Padding="24,16">
                <StackPanel Spacing="0">
                    <TextBlock Text="{Binding [Accommodations_Optimization], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{ThemeResource AppleSecondaryBrush}" />
                    <Slider x:Name="OptimizationSlider" Style="{StaticResource TransparencySlider}" Minimum="0" Maximum="2" StepFrequency="1" SnapsTo="StepValues" ValueChanged="Optimization_Changed" AutomationProperties.Name="{Binding [Accommodations_Optimization], Source={StaticResource Loc}}" />
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Accommodations_Slight], Source={StaticResource Loc}}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding [Accommodations_Moderate], Source={StaticResource Loc}}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding [Accommodations_Strong], Source={StaticResource Loc}}" FontSize="12" TextAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding [Accommodations_OptimizationHelp], Source={StaticResource Loc}}" FontSize="12" Margin="16,0" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding [Accommodations_CustomizedAudio], Source={StaticResource Loc}}" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid Padding="16,15" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Accommodations_Phone], Source={StaticResource Loc}}" FontSize="14" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="PhoneBox" Grid.Column="1" Style="{StaticResource SettingToggle}" AutomationProperties.Name="{Binding [Accommodations_Phone], Source={StaticResource Loc}}" Toggled="Destination_Changed" />
                    </Grid>
                    <Border Style="{StaticResource InsetDivider}" />
                    <Grid Padding="16,15" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Accommodations_Media], Source={StaticResource Loc}}" FontSize="14" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="MediaBox" Grid.Column="1" Style="{StaticResource SettingToggle}" AutomationProperties.Name="{Binding [Accommodations_Media], Source={StaticResource Loc}}" Toggled="Destination_Changed" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        <TextBlock x:Name="ResultText" FontSize="12" Margin="16,0" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="TransparencyButton" Style="{StaticResource AppleNavigationButton}" Click="Transparency_Click" AutomationProperties.Name="{Binding [Apple_Transparency], Source={StaticResource Loc}}">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Apple_Transparency], Source={StaticResource Loc}}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>
