<UserControl x:Class="NTPods.WinUI.Controls.HeadTrackingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander x:Name="Panel" Style="{StaticResource GroupExpander}"
              Expanding="Panel_Expanding" Collapsed="Panel_Collapsed">
        <Expander.Header>
            <TextBlock Text="{Binding [HeadTracking_Title], Source={StaticResource Loc}}" FontSize="16" />
        </Expander.Header>
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [HeadTracking_LiveMovement], Source={StaticResource Loc}}"
                           FontSize="16" VerticalAlignment="Center" />
                <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource QuietButton}"
                        MinWidth="40" MinHeight="40" Click="Start_Click">
                    <FontIcon x:Name="StartIcon" FontSize="16" Glyph="&#xE768;" />
                </Button>
            </Grid>
            <Border CornerRadius="20" Background="{ThemeResource ApplePageBrush}" Padding="16">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource NTPodsAccentBrush}" />
                            <TextBlock Text="{Binding [HeadTracking_Horizontal], Source={StaticResource Loc}}"
                                       FontSize="12" Foreground="{ThemeResource AppleSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{ThemeResource AppleGreenBrush}" />
                            <TextBlock Text="{Binding [HeadTracking_Vertical], Source={StaticResource Loc}}"
                                       FontSize="12" Foreground="{ThemeResource AppleSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="GraphHost" Height="220" SizeChanged="Graph_SizeChanged"
                          AutomationProperties.Name="{Binding [HeadTracking_LiveMovement], Source={StaticResource Loc}}">
                        <Canvas x:Name="Graph" IsHitTestVisible="False">
                            <Path x:Name="Guides" Stroke="{ThemeResource AppleSecondaryBrush}" StrokeThickness="1" Opacity="0.14" />
                            <Line x:Name="ZeroLine" Stroke="{ThemeResource AppleSecondaryBrush}" StrokeThickness="1" Opacity="0.28" />
                            <Polyline x:Name="HorizontalTrace" Stroke="{ThemeResource NTPodsAccentBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Polyline x:Name="VerticalTrace" Stroke="{ThemeResource AppleGreenBrush}" StrokeThickness="2"
                                      StrokeDashArray="4,2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                   Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </Expander>
</UserControl>
