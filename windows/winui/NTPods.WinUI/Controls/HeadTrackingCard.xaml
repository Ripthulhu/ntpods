<UserControl x:Class="NTPods.WinUI.Controls.HeadTrackingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NTPods.WinUI.Controls">
    <StackPanel Spacing="12">
        <Button x:Name="StartButton" Click="Start_Click" HorizontalAlignment="Center" MinHeight="46"
                Padding="22,8" Style="{StaticResource GlassActionButton}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="StartIcon" Glyph="&#xE768;" FontSize="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="StartLabel" Text="{Binding [Spatial_Start], Source={StaticResource Loc}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <TextBlock x:Name="Status" AutomationProperties.LiveSetting="Polite" Margin="16,0"
                   FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource AppleSecondaryBrush}" />
        <controls:SpeakerRoomCard x:Name="Room"/>
        <Border Style="{StaticResource Card}" Padding="16">
            <StackPanel Spacing="8">
                <Button x:Name="CalibrateButton" Click="Calibrate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="44"
                        ToolTipService.ToolTip="{Binding [Spatial_CalibrationHelp], Source={StaticResource Loc}}"
                        AutomationProperties.HelpText="{Binding [Spatial_CalibrationHelp], Source={StaticResource Loc}}"
                        Style="{StaticResource QuietButton}">
                    <TextBlock Text="{Binding [Spatial_Calibrate], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                </Button>
                <Border x:Name="ActionDivider" Style="{StaticResource InsetDivider}" />
                <Button x:Name="CompareButton" Click="Compare_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="44"
                        Style="{StaticResource QuietButton}">
                    <TextBlock Text="{Binding [Spatial_Compare], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                </Button>
                <StackPanel x:Name="ProfileChoices" Spacing="8" Visibility="Collapsed">
                    <ComboBox x:Name="ProfilePicker" SelectedIndex="0" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{Binding [Spatial_ProfileChoice], Source={StaticResource Loc}}">
                        <ComboBoxItem Content="A" />
                        <ComboBoxItem Content="B" />
                        <ComboBoxItem Content="C" />
                    </ComboBox>
                    <Button x:Name="PreviewButton" Click="Preview_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"
                            Content="{Binding [Spatial_Preview], Source={StaticResource Loc}}" />
                    <Button x:Name="SaveButton" Click="Save_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"
                            Content="{Binding [Spatial_Save], Source={StaticResource Loc}}" />
                </StackPanel>
                <StackPanel x:Name="CalibrationGuide" Spacing="12" Margin="8,8" Visibility="Collapsed">
                    <Grid Height="88">
                        <StackPanel x:Name="CalibrationBuds" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Spacing="8" AutomationProperties.AccessibilityView="Raw">
                            <Image Source="ms-appx:///Assets/settings_airpods_pro_3_left.png" Width="55" Height="72" />
                            <Image Source="ms-appx:///Assets/settings_airpods_pro_3_right.png" Width="55" Height="72" />
                        </StackPanel>
                        <FontIcon x:Name="CalibrationArrow" FontFamily="Segoe Fluent Icons" FontSize="64"
                                  Foreground="{ThemeResource NTPodsAccentBrush}" Visibility="Collapsed"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <TextBlock x:Name="CalibrationInstruction" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="18" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="CalibrationProgress" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
                <Button x:Name="CancelButton" Click="Cancel_Click" Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Stretch" Visibility="Collapsed" Content="{Binding [Dongle_Cancel], Source={StaticResource Loc}}" />
            </StackPanel>
        </Border>
        <HyperlinkButton Click="SoundSettings_Click" HorizontalAlignment="Left" Margin="4,0"
                         Content="{Binding [Spatial_SoundSettings], Source={StaticResource Loc}}" />
    </StackPanel>
</UserControl>
