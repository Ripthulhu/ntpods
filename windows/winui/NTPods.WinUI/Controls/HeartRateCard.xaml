<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NTPods.WinUI.Controls.HeartRateCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Expander x:Name="Panel" Style="{StaticResource GroupExpander}" IsExpanded="False">
        <Expander.Header>
            <TextBlock Text="{Binding [HeartRateTitle_Text], Source={StaticResource Loc}}" FontSize="16" />
        </Expander.Header>
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [HeartRateSwitch_Header], Source={StaticResource Loc}}"
                           FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="HeartRateSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}"
                              AutomationProperties.Name="{Binding [HeartRateSwitch_Header], Source={StaticResource Loc}}"
                              Toggled="HeartRate_Toggled" />
            </Grid>
            <TextBlock Text="{Binding [HeartRateSubtitle_Text], Source={StaticResource Loc}}"
                       Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="13"
                       TextWrapping="Wrap" />
            <!-- Current BPM on the left, min/avg/max of the window on the right. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <TextBlock x:Name="HeartRateBpm"
                               Text="—"
                               FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [HeartRateBpmLabel_Text], Source={StaticResource Loc}}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,4"
                               Foreground="{ThemeResource AppleSecondaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="HeartRateGraphCaption" Grid.Column="1"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                           TextWrapping="Wrap" TextAlignment="Right"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource AppleSecondaryBrush}" />
            </Grid>
            <!-- What the graph shows: live (last minute) or a past session from the
                 daemon's heart-rate database. The list refreshes when it opens. -->
            <ComboBox x:Name="HistoryPicker"
                      Header="{Binding [HeartRateHistory_Header], Source={StaticResource Loc}}"
                      AutomationProperties.Name="{Binding [HeartRateHistory_Header], Source={StaticResource Loc}}"
                      HorizontalAlignment="Stretch"
                      DropDownOpened="HistoryPicker_DropDownOpened"
                      SelectionChanged="HistoryPicker_SelectionChanged" />
            <!-- Full-width graph of the recent readings (like HeartRateMiniGraph in
                 upstream PR #702): the scale's BPM on the left axis, a guide per axis
                 label, and the value under the pointer on hover. Drawn in code-behind. -->
            <Grid ColumnSpacing="8" Height="140">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid MinWidth="24">
                    <TextBlock x:Name="GraphAxisMax" VerticalAlignment="Top" HorizontalAlignment="Right"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AppleSecondaryBrush}" />
                    <TextBlock x:Name="GraphAxisMid" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AppleSecondaryBrush}" />
                    <TextBlock x:Name="GraphAxisMin" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AppleSecondaryBrush}" />
                </Grid>
                <ContentControl x:Name="GraphFocus" Grid.Column="1" IsTabStop="True" UseSystemFocusVisuals="True"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding [HeartRateGraph_AccessibleName], Source={StaticResource Loc}}"
                                AutomationProperties.HelpText="{Binding [HeartRateGraph_KeyboardHelp], Source={StaticResource Loc}}"
                                GotFocus="Graph_GotFocus" LostFocus="Graph_LostFocus" KeyDown="Graph_KeyDown">
                    <Grid>
                        <Canvas x:Name="HeartRateGraph" Background="Transparent"
                                SizeChanged="HeartRateGraph_SizeChanged"
                                PointerMoved="HeartRateGraph_PointerMoved"
                                PointerExited="HeartRateGraph_PointerExited" />
                        <Canvas x:Name="GraphOverlay" IsHitTestVisible="False" />
                    </Grid>
                </ContentControl>
            </Grid>
        </StackPanel>
    </Expander>
</UserControl>
