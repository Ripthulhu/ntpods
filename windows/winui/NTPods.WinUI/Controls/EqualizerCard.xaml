<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NTPods.WinUI.Controls.EqualizerCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander x:Name="EqualizerExpander" Style="{StaticResource GroupExpander}">
        <Expander.Header>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [Equalizer_Title], Source={StaticResource Loc}}" FontSize="16" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding [Equalizer_Description], Source={StaticResource Loc}}" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" />
            <StackPanel x:Name="Editors" Spacing="12">
                <Slider x:Name="LowSlider" Header="{Binding [Equalizer_Bass], Source={StaticResource Loc}}" Minimum="0" Maximum="100" StepFrequency="1" Value="50" ValueChanged="Band_Changed" />
                <Slider x:Name="MidSlider" Header="{Binding [Equalizer_Mid], Source={StaticResource Loc}}" Minimum="0" Maximum="100" StepFrequency="1" Value="50" ValueChanged="Band_Changed" />
                <Slider x:Name="HighSlider" Header="{Binding [Equalizer_Treble], Source={StaticResource Loc}}" Minimum="0" Maximum="100" StepFrequency="1" Value="50" ValueChanged="Band_Changed" />
                <TextBlock x:Name="ValuesText" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="ApplyButton" Click="Apply_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <TextBlock Text="{Binding [Equalizer_Apply], Source={StaticResource Loc}}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                    <Button x:Name="RecommendedButton" Grid.Column="1" Click="Recommended_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <TextBlock Text="{Binding [Equalizer_Recommended], Source={StaticResource Loc}}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Expander>
</UserControl>
