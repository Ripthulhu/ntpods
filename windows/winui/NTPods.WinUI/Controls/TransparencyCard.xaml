<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:NTPods.WinUI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NTPods.WinUI.Controls.TransparencyCard">

    <StackPanel Spacing="16">
        <StackPanel Spacing="16" x:Name="Options" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="12" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Transparency_Enable], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="EnableSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}" AutomationProperties.Name="{Binding [Transparency_Enable], Source={StaticResource Loc}}" Toggled="Toggle_Changed" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24,16" MinHeight="104">
                <StackPanel Spacing="0">
                    <TextBlock Text="{Binding [Transparency_Amplification], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppleSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <Slider x:Name="Amplification" Style="{StaticResource TransparencySlider}" AutomationProperties.Name="{Binding [Transparency_Amplification], Source={StaticResource Loc}}" Minimum="-100" Maximum="100" StepFrequency="1" ValueChanged="Slider_Changed" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24,16" MinHeight="104">
                <StackPanel Spacing="0">
                    <TextBlock Text="{Binding [Transparency_Balance], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppleSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <Slider x:Name="Balance" Style="{StaticResource TransparencySlider}" AutomationProperties.Name="{Binding [Transparency_Balance], Source={StaticResource Loc}}" Minimum="-200" Maximum="200" StepFrequency="1" ValueChanged="Slider_Changed" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24,16" MinHeight="104">
                <StackPanel Spacing="0">
                    <TextBlock Text="{Binding [Transparency_Tone], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppleSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <Slider x:Name="Tone" Style="{StaticResource TransparencySlider}" AutomationProperties.Name="{Binding [Transparency_Tone], Source={StaticResource Loc}}" Minimum="-100" Maximum="100" StepFrequency="1" ValueChanged="Slider_Changed" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24,16" MinHeight="104">
                <StackPanel Spacing="0">
                    <TextBlock Text="{Binding [Transparency_Ambient], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppleSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <Slider x:Name="Ambient" Style="{StaticResource TransparencySlider}" AutomationProperties.Name="{Binding [Transparency_Ambient], Source={StaticResource Loc}}" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Slider_Changed" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="24,16" MinHeight="104">
                <StackPanel Spacing="0">
                    <TextBlock Text="{Binding [Transparency_OwnVoice], Source={StaticResource Loc}}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppleSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <Slider x:Name="OwnVoice" Style="{StaticResource TransparencySlider}" AutomationProperties.Name="{Binding [Transparency_OwnVoice], Source={StaticResource Loc}}" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Slider_Changed" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="12" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Transparency_Boost], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="BoostSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}" AutomationProperties.Name="{Binding [Transparency_Boost], Source={StaticResource Loc}}" Toggled="Toggle_Changed" />
                </Grid>
            </Border>
        </StackPanel>
        <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Margin="16,0" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>