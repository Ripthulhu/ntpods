<ContentDialog x:Class="NTPods.WinUI.Controls.PairAirPodsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:NTPods.WinUI.Services"
    Title="{Binding [Pairing_Title], Source={StaticResource Loc}}"
    PrimaryButtonText="{Binding [Pairing_Pair], Source={StaticResource Loc}}"
    SecondaryButtonText="{Binding [Pairing_SearchAgain], Source={StaticResource Loc}}"
    CloseButtonText="{Binding [Action_Cancel], Source={StaticResource Loc}}"
    IsPrimaryButtonEnabled="False"
    Opened="Dialog_Opened" Closed="Dialog_Closed"
    PrimaryButtonClick="Pair_Click" SecondaryButtonClick="Search_Click">
    <StackPanel Spacing="16" MinWidth="240" MaxWidth="420">
        <TextBlock Text="{Binding [Pairing_Instructions], Source={StaticResource Loc}}"
                   TextWrapping="Wrap" />
        <ListView x:Name="DeviceList" MinHeight="144" MaxHeight="240"
                  SelectionMode="Single" SelectionChanged="Selection_Changed"
                  AutomationProperties.Name="{Binding [Pairing_Devices], Source={StaticResource Loc}}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:PairingCandidate">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" Padding="0,8" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Spacing="8">
            <ProgressBar x:Name="Progress" IsIndeterminate="False" Height="4" Opacity="0" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13" MinHeight="20"
                       Foreground="{ThemeResource AppleSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
