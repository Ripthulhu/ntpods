<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NTPods.WinUI.Controls.DongleCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding [Dongle_Title], Source={StaticResource Loc}}" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConnectionText" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressRing x:Name="PendingRing" Grid.Column="1" Width="20" Height="20" IsActive="False" Visibility="Collapsed"
                    AutomationProperties.Name="{Binding [Companion_Pending], Source={StaticResource Loc}}" />
            </Grid>
            <TextBlock Text="{Binding [Dongle_OutputHelp], Source={StaticResource Loc}}" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
            <Grid x:Name="Batteries" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4"><TextBlock Text="{Binding [Battery_LeftShort], Source={StaticResource Loc}}" FontSize="12" Foreground="{ThemeResource AppleSecondaryBrush}" /><TextBlock x:Name="LeftBattery" FontSize="17" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding [Battery_RightShort], Source={StaticResource Loc}}" FontSize="12" Foreground="{ThemeResource AppleSecondaryBrush}" /><TextBlock x:Name="RightBattery" FontSize="17" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{Binding [Battery_CaseShort], Source={StaticResource Loc}}" FontSize="12" Foreground="{ThemeResource AppleSecondaryBrush}" /><TextBlock x:Name="CaseBattery" FontSize="17" /></StackPanel>
            </Grid>
            <Grid x:Name="Modes" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ToggleButton x:Name="AncButton" Tag="2" Click="Mode_Click" HorizontalAlignment="Stretch" MinHeight="44"
                    ><TextBlock Text="{Binding [Anc_NoiseCancellation], Source={StaticResource Loc}}" TextWrapping="Wrap" TextAlignment="Center" /></ToggleButton>
                <ToggleButton x:Name="TransparencyButton" Grid.Column="1" Tag="3" Click="Mode_Click" HorizontalAlignment="Stretch" MinHeight="44"
                    ><TextBlock Text="{Binding [Anc_Transparency], Source={StaticResource Loc}}" TextWrapping="Wrap" TextAlignment="Center" /></ToggleButton>
            </Grid>
            <Border Style="{StaticResource InsetDivider}" />
            <Button x:Name="ReconnectButton" Click="Reconnect_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" MinHeight="44"
                ><TextBlock Text="{Binding [Dongle_Reconnect], Source={StaticResource Loc}}" TextWrapping="Wrap" TextAlignment="Center" /></Button>
            <Button x:Name="PairButton" Click="Pair_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" MinHeight="44"
                ><TextBlock Text="{Binding [Dongle_Pair], Source={StaticResource Loc}}" TextWrapping="Wrap" TextAlignment="Center" /></Button>
            <Button x:Name="PhoneButton" Click="Phone_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" MinHeight="44"
                ><TextBlock Text="{Binding [Dongle_Phone], Source={StaticResource Loc}}" TextWrapping="Wrap" TextAlignment="Center" /></Button>
            <TextBlock Text="{Binding [Dongle_NativeHelp], Source={StaticResource Loc}}" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap"
                Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Border>
    <Expander x:Name="DiagnosticsExpander" Style="{StaticResource GroupExpander}" Header="{Binding [Dongle_Diagnostics], Source={StaticResource Loc}}" Visibility="Collapsed">
        <StackPanel Spacing="12">
            <Button x:Name="DiagnosticsRefresh" Click="Diagnostics_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"
                    Content="{Binding [Dongle_ReadDiagnostics], Source={StaticResource Loc}}" />
            <StackPanel x:Name="DiagnosticValues" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="DiagnosticQueue" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticMemory" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticEncoding" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticDrops" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticRecovery" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding [Dongle_CountersHelp], Source={StaticResource Loc}}" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Expander>
    </StackPanel>
</UserControl>
