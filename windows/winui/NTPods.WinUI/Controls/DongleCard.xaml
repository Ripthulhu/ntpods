<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NTPods.WinUI.Controls.DongleCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander x:Name="DongleOptions" Style="{StaticResource GroupExpander}" Header="{Binding [Dongle_Title], Source={StaticResource Loc}}">
        <StackPanel Spacing="16">
            <Grid x:Name="ConnectionRow" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ConnectionText" FontSize="12" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
                <ProgressRing x:Name="PendingRing" Grid.Column="1" Width="20" Height="20" IsActive="False" Visibility="Collapsed"
                    AutomationProperties.Name="{Binding [Companion_Pending], Source={StaticResource Loc}}" />
            </Grid>
            <ComboBox x:Name="DevicePicker" HorizontalAlignment="Stretch" DisplayMemberPath="Serial" SelectedValuePath="Serial"
                SelectionChanged="Device_Changed" Visibility="Collapsed"
                PlaceholderText="{Binding [Dongle_Choose], Source={StaticResource Loc}}"
                AutomationProperties.Name="{Binding [Dongle_Choose], Source={StaticResource Loc}}" />
            <TextBlock x:Name="OutputHelpText" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
            <StackPanel x:Name="ReconnectRow" Visibility="Collapsed" Spacing="6">
                <Grid ColumnSpacing="16" MinHeight="44">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Dongle_AutoConnect], Source={StaticResource Loc}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="ReconnectSwitch" Grid.Column="1" Style="{StaticResource SettingToggle}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding [Dongle_AutoConnect], Source={StaticResource Loc}}" Toggled="Reconnect_Toggled" />
                </Grid>
                <TextBlock x:Name="ReconnectHelp" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Border Style="{StaticResource GlassActionGroup}">
                <StackPanel>
                    <Button x:Name="PairButton" Click="Pair_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" MinHeight="44">
                        <TextBlock Text="{Binding [Dongle_Pair], Source={StaticResource Loc}}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                    <Border Style="{StaticResource InsetDivider}" />
                    <Button x:Name="PhoneButton" Click="Phone_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" MinHeight="44">
                        <TextBlock Text="{Binding [Dongle_BluetoothAudioPair], Source={StaticResource Loc}}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap"
                Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        <StackPanel x:Name="DiagnosticsSection" Spacing="12" Visibility="Collapsed">
            <Border Style="{StaticResource InsetDivider}" />
            <Button x:Name="DiagnosticsRefresh" Click="Diagnostics_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"
                    Content="{Binding [Dongle_ReadDiagnostics], Source={StaticResource Loc}}" />
            <StackPanel x:Name="DiagnosticValues" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="DiagnosticQueue" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticMemory" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticEncoding" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticDrops" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DiagnosticRecovery" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding [Dongle_CountersHelp], Source={StaticResource Loc}}" FontSize="13" Foreground="{ThemeResource AppleSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        </StackPanel>
    </Expander>
</UserControl>
