<UserControl x:Class="NTPods.WinUI.Popup.ConnectPromptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="400" RequestedTheme="Light">
    <ScrollViewer x:Name="CardScroll" Background="{ThemeResource AppleGroupBrush}"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,24" Spacing="12">
            <Grid MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DeviceName" Grid.Column="1" FontSize="24" FontWeight="SemiBold"
                           TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="CloseButton" Grid.Column="2" Width="40" Height="40" Padding="0"
                        Style="{StaticResource QuietButton}" VerticalAlignment="Top" Click="Close_Click"
                        AutomationProperties.Name="{Binding [Action_Close], Source={StaticResource Loc}}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </Grid>
            <Grid x:Name="ArtworkHost" Height="160">
                <Image x:Name="DeviceImage" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                <Viewbox x:Name="ArtworkViewport" Stretch="Uniform" IsHitTestVisible="False"
                         AutomationProperties.AccessibilityView="Raw">
                    <Grid Width="1050" Height="354">
                        <MediaPlayerElement x:Name="ArtworkVideo" Width="1050" Height="354" Stretch="Fill" Visibility="Collapsed"
                                            AreTransportControlsEnabled="False" IsHitTestVisible="False" IsTabStop="False"
                                            Background="{ThemeResource AppleGroupBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <Image x:Name="ArtworkPoster" Stretch="Fill" Visibility="Collapsed"
                               AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Viewbox>
            </Grid>
            <Grid MinHeight="96">
                <Grid x:Name="StatusContent">
                    <TextBlock x:Name="OutgoingStatusText" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{ThemeResource AppleSecondaryBrush}"
                               AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="StatusText" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{ThemeResource AppleSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
                <StackPanel x:Name="CompletedContent" Spacing="8"
                            IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock x:Name="PairedLabel" Text="{Binding [ConnectPrompt_Paired], Source={StaticResource Loc}}"
                               FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <Grid x:Name="BatteryRow" ColumnSpacing="12" AutomationProperties.LiveSetting="Polite">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="BudsCell" Grid.Column="0" Spacing="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="BudsLabel" FontSize="12" TextAlignment="Center"
                                       Foreground="{ThemeResource AppleSecondaryBrush}"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <ProgressRing x:Name="BudsRing" Width="24" Height="24" IsIndeterminate="False"
                                                  IsActive="True" Minimum="0" Maximum="100" Value="0"
                                                  Foreground="{ThemeResource AppleGreenBrush}"
                                                  Background="{ThemeResource AppleDividerBrush}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    <Path x:Name="BudsCharging" Width="8" Height="12" Stretch="Uniform"
                                          Fill="{ThemeResource AppleGreenBrush}" Visibility="Collapsed"
                                          Data="M 8,0 L 0,9 L 4,9 L 2,16 L 10,7 L 6,7 Z" />
                                </Grid>
                                <TextBlock x:Name="BudsValue" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="RightRow" Orientation="Horizontal" Spacing="4"
                                        HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="RightValue" FontSize="14" TextAlignment="Center" />
                                <Path x:Name="RightCharging" Width="6" Height="10" Stretch="Uniform"
                                      Fill="{ThemeResource AppleGreenBrush}" Visibility="Collapsed"
                                      Data="M 8,0 L 0,9 L 4,9 L 2,16 L 10,7 L 6,7 Z" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="CaseCell" Grid.Column="1" Spacing="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="CaseLabel" FontSize="12" TextAlignment="Center"
                                       Foreground="{ThemeResource AppleSecondaryBrush}"
                                       Text="{Binding [BatteryCaseLabel_Text], Source={StaticResource Loc}}"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <ProgressRing x:Name="CaseRing" Width="24" Height="24" IsIndeterminate="False"
                                                  IsActive="True" Minimum="0" Maximum="100" Value="0"
                                                  Foreground="{ThemeResource AppleGreenBrush}"
                                                  Background="{ThemeResource AppleDividerBrush}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    <Path x:Name="CaseCharging" Width="8" Height="12" Stretch="Uniform"
                                          Fill="{ThemeResource AppleGreenBrush}" Visibility="Collapsed"
                                          Data="M 8,0 L 0,9 L 4,9 L 2,16 L 10,7 L 6,7 Z" />
                                </Grid>
                                <TextBlock x:Name="CaseValue" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
            <Button x:Name="ConnectButton" Height="48" HorizontalAlignment="Stretch" CornerRadius="24"
                    Style="{StaticResource AccentButtonStyle}" Click="Connect_Click"
                    AutomationProperties.Name="{Binding [ConnectPrompt_Connect], Source={StaticResource Loc}}">
                <Grid>
                    <TextBlock x:Name="ConnectLabel" Text="{Binding [ConnectPrompt_Connect], Source={StaticResource Loc}}"
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="ContinueLabel" Text="{Binding [ConnectPrompt_Continue], Source={StaticResource Loc}}"
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                    <ProgressRing x:Name="Progress" Width="24" Height="24" IsActive="False"
                                  AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
