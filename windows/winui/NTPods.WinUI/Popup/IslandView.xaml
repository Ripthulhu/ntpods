<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NTPods.WinUI.Popup.IslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NTPods.WinUI.Controls"
    Width="400" MinHeight="160" AutomationProperties.LiveSetting="Polite">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="IslandBackground" Color="Black" />
                    <SolidColorBrush x:Key="IslandForeground" Color="White" />
                    <SolidColorBrush x:Key="IslandSecondary" Color="#A1A1A6" />
                    <SolidColorBrush x:Key="IslandBattery" Color="#30D158" />
                    <SolidColorBrush x:Key="IslandBatteryTrack" Color="#333333" />
                    <SolidColorBrush x:Key="IslandLowBattery" Color="#FF6961" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="IslandBackground" Color="Black" />
                    <SolidColorBrush x:Key="IslandForeground" Color="White" />
                    <SolidColorBrush x:Key="IslandSecondary" Color="#A1A1A6" />
                    <SolidColorBrush x:Key="IslandBattery" Color="#30D158" />
                    <SolidColorBrush x:Key="IslandBatteryTrack" Color="#333333" />
                    <SolidColorBrush x:Key="IslandLowBattery" Color="#FF6961" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="IslandBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="IslandForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IslandSecondary" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="IslandBattery" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="IslandBatteryTrack" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="IslandLowBattery" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{ThemeResource IslandBackground}" Padding="24,18,24,20" RowSpacing="14">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LeftBatteryColors">
                <VisualState x:Name="LeftNormal" />
                <VisualState x:Name="LeftLow">
                    <VisualState.Setters>
                        <Setter Target="LeftRing.Foreground" Value="{ThemeResource IslandLowBattery}" />
                        <Setter Target="LeftBolt.Fill" Value="{ThemeResource IslandLowBattery}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="RightBatteryColors">
                <VisualState x:Name="RightNormal" />
                <VisualState x:Name="RightLow">
                    <VisualState.Setters>
                        <Setter Target="RightRing.Foreground" Value="{ThemeResource IslandLowBattery}" />
                        <Setter Target="RightBolt.Fill" Value="{ThemeResource IslandLowBattery}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="CaseBatteryColors">
                <VisualState x:Name="CaseNormal" />
                <VisualState x:Name="CaseLow">
                    <VisualState.Setters>
                        <Setter Target="CaseRing.Foreground" Value="{ThemeResource IslandLowBattery}" />
                        <Setter Target="CaseBolt.Fill" Value="{ThemeResource IslandLowBattery}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="HeaderGrid" ColumnSpacing="12" MinHeight="56">
            <Grid.RenderTransform><TranslateTransform x:Name="HeaderOffset" /></Grid.RenderTransform>
            <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image x:Name="DeviceImage" Height="54" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="DeviceName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource IslandForeground}" />
                <Grid>
                    <TextBlock x:Name="PreviousMessage" FontSize="13" TextTrimming="CharacterEllipsis" Opacity="0"
                               Foreground="{ThemeResource IslandSecondary}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="MessageBody" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource IslandSecondary}">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="MessageOffset" /></TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <Grid x:Name="MessageIcons" Grid.Column="2" Width="28" Height="28" Visibility="Collapsed"
                  AutomationProperties.AccessibilityView="Raw">
                <controls:ListeningModeIcon x:Name="TransparencyIcon" Width="28" Height="28" UriSource="ms-appx:///Assets/ic_transparency.png"
                                            Foreground="{ThemeResource IslandForeground}" />
                <controls:ListeningModeIcon x:Name="AdaptiveIcon" Width="28" Height="28" UriSource="ms-appx:///Assets/ic_adaptive.png"
                                            Foreground="{ThemeResource IslandForeground}" />
                <controls:ListeningModeIcon x:Name="NoiseCancellationIcon" Width="28" Height="28" UriSource="ms-appx:///Assets/ic_noise_cancellation.png"
                                            Foreground="{ThemeResource IslandForeground}" />
                <FontIcon x:Name="MicIcon" Glyph="&#xE720;" FontSize="24" Foreground="{ThemeResource IslandForeground}" />
                <Grid x:Name="MicOffIcon">
                    <FontIcon Glyph="&#xE720;" FontSize="24" Foreground="{ThemeResource IslandForeground}" />
                    <Path Data="M 3,3 L 25,25" StrokeThickness="2" Stroke="{ThemeResource IslandForeground}" />
                </Grid>
            </Grid>
        </Grid>
        <StackPanel x:Name="BatteryPanel" Grid.Row="1" Spacing="8">
            <StackPanel.RenderTransform><TranslateTransform x:Name="BatteryOffset" /></StackPanel.RenderTransform>
            <Grid x:Name="BatteryRow" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid x:Name="LeftCell" Grid.Column="0" ColumnSpacing="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <ProgressRing x:Name="LeftRing" IsIndeterminate="False" IsActive="True" Minimum="0" Maximum="100"
                                      Foreground="{ThemeResource IslandBattery}" Background="{ThemeResource IslandBatteryTrack}" />
                        <Path x:Name="LeftBolt" Width="10" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Data="M 8,0 L 0,9 L 4,9 L 2,16 L 10,7 L 6,7 Z"
                                  Fill="{ThemeResource IslandBattery}" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LeftText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource IslandForeground}" />
                        <TextBlock x:Name="LeftLabel" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource IslandSecondary}" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="RightCell" Grid.Column="1" ColumnSpacing="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <ProgressRing x:Name="RightRing" IsIndeterminate="False" IsActive="True" Minimum="0" Maximum="100"
                                      Foreground="{ThemeResource IslandBattery}" Background="{ThemeResource IslandBatteryTrack}" />
                        <Path x:Name="RightBolt" Width="10" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Data="M 8,0 L 0,9 L 4,9 L 2,16 L 10,7 L 6,7 Z"
                                  Fill="{ThemeResource IslandBattery}" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="RightText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource IslandForeground}" />
                        <TextBlock x:Name="RightLabel" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource IslandSecondary}" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="CaseCell" Grid.Column="2" ColumnSpacing="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <ProgressRing x:Name="CaseRing" IsIndeterminate="False" IsActive="True" Minimum="0" Maximum="100"
                                      Foreground="{ThemeResource IslandBattery}" Background="{ThemeResource IslandBatteryTrack}" />
                        <Path x:Name="CaseBolt" Width="10" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Data="M 8,0 L 0,9 L 4,9 L 2,16 L 10,7 L 6,7 Z"
                                  Fill="{ThemeResource IslandBattery}" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CaseText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource IslandForeground}" />
                        <TextBlock x:Name="CaseLabel" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource IslandSecondary}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <TextBlock x:Name="FreshnessText" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                       Foreground="{ThemeResource IslandSecondary}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
