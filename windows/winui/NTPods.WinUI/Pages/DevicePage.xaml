<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:NTPods.WinUI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NTPods.WinUI.Pages.DevicePage" FontFamily="{StaticResource AppleBodyFont}" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:DeviceHeader x:Name="Header" MaxWidth="608" HorizontalAlignment="Stretch" />
        <Grid x:Name="SubpageNavigation" Visibility="Collapsed" MinHeight="48" ColumnSpacing="12" Height="64" MaxWidth="608" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SubpageBackButton" Style="{StaticResource CircleButton}" Click="SubpageBack_Click" AutomationProperties.Name="{Binding [Navigation_Back], Source={StaticResource Loc}}">
                <FontIcon Glyph="" FontSize="16" />
            </Button>
            <TextBlock x:Name="SubpageTitle" Grid.Column="1" FontSize="22" TextWrapping="NoWrap" VerticalAlignment="Center" FontWeight="ExtraBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
        <ScrollViewer x:Name="PageScrollViewer" Background="Transparent" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" Grid.Row="1">
            <Grid HorizontalAlignment="Stretch">
                <StackPanel x:Name="DeviceRoot" MaxWidth="608" Padding="16,16,16,32" Spacing="16" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="MainSections" Spacing="16">
                        <controls:BatteryCard x:Name="BatteryCard" />
                        <Button x:Name="OfflineSpatialStop" Visibility="Collapsed" Click="OfflineSpatialStop_Click"
                                Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"
                                Content="{Binding [Spatial_Stop], Source={StaticResource Loc}}" />
                        <InfoBar x:Name="PairingError" IsOpen="False" Visibility="Collapsed" Severity="Error" Closed="PairingError_Closed" />
                        <ContentControl x:Name="DeviceBody" IsTabStop="False" HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="DeviceSections" Spacing="16">
                                <Button x:Name="NameButton" Tag="rename" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Apple_Name], Source={StaticResource Loc}}">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Apple_Name], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NameValue" Grid.Column="1" MaxWidth="220" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        <FontIcon Grid.Column="2" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="HealthSections" Spacing="0">
                                    <TextBlock Text="{Binding [Apple_HearingHealth], Source={StaticResource Loc}}" Style="{StaticResource SectionTitle}" />
                                    <Border Style="{StaticResource Card}" Padding="0">
                                        <StackPanel>
                                            <Button x:Name="HearingProtectionButton" Tag="protection" Click="Navigate_Click" Style="{StaticResource AppleGroupedNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Apple_HearingProtection], Source={StaticResource Loc}}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding [Apple_HearingProtection], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                                </Grid>
                                            </Button>
                                            <Border Style="{StaticResource InsetDivider}" x:Name="HealthDivider" />
                                            <Button x:Name="HearingAidButton" Tag="hearing" Click="Navigate_Click" Style="{StaticResource AppleGroupedNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Apple_HearingAid], Source={StaticResource Loc}}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding [Apple_HearingAid], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <controls:NoiseControlCard x:Name="NoiseControlCard" />
                                <Button x:Name="HeartRateButton" Tag="heart" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [HeartRateTitle_Text], Source={StaticResource Loc}}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [HeartRateTitle_Text], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="PressHoldGroup">
                                    <TextBlock Text="{Binding [Apple_PressHold], Source={StaticResource Loc}}" Style="{StaticResource SectionTitle}" />
                                    <Border Style="{StaticResource Card}" Padding="0">
                                        <StackPanel>
                                            <Button x:Name="LeftHoldButton" Tag="left" Click="Navigate_Click" Style="{StaticResource AppleGroupedNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Apple_Left], Source={StaticResource Loc}}">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding [Apple_Left], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="LeftHoldValue" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                                    <FontIcon Grid.Column="2" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                                </Grid>
                                            </Button>
                                            <Border Style="{StaticResource InsetDivider}" />
                                            <Button x:Name="RightHoldButton" Tag="right" Click="Navigate_Click" Style="{StaticResource AppleGroupedNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Apple_Right], Source={StaticResource Loc}}">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding [Apple_Right], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="RightHoldValue" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                                    <FontIcon Grid.Column="2" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Button x:Name="CallControlsButton" Tag="calls" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Apple_CallControls], Source={StaticResource Loc}}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Apple_CallControls], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <controls:FeaturesCard x:Name="FeaturesCard" />
                                <StackPanel x:Name="VolumeSections" Spacing="12">
                                    <Button x:Name="EqualizerButton" Tag="equalizer" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Apple_Equalizer], Source={StaticResource Loc}}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Apple_Equalizer], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <Border x:Name="EarDetectionGroup" Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="EarDetectionRows" />
                                </Border>
                                <Button x:Name="MicrophoneButton" Tag="microphone" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Apple_MicrophoneMode], Source={StaticResource Loc}}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Apple_MicrophoneMode], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <Border x:Name="SleepGroup" Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="SleepRows" />
                                </Border>
                                <Border x:Name="OptimizedGroup" Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="OptimizedRows" />
                                </Border>
                                <Button x:Name="AccessibilityButton" Tag="accessibility" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Apple_Accessibility], Source={StaticResource Loc}}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Apple_Accessibility], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <Border x:Name="OffListeningGroup" Style="{StaticResource Card}" Padding="0">
                                    <ContentControl x:Name="OffListeningHost" HorizontalContentAlignment="Stretch" />
                                </Border>
                                <Button x:Name="AboutButton" Tag="about" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [SettingsAbout_Text], Source={StaticResource Loc}}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [SettingsAbout_Text], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="ExtraSections" Spacing="16">
                                    <TextBlock Text="NTPods" Style="{StaticResource SectionTitle}" />
                                    <Button Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" Click="PhoneConnection_Click"
                                            AutomationProperties.Name="{Binding [CompanionSetup_Title], Source={StaticResource Loc}}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [CompanionSetup_Title], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <controls:CompanionCard x:Name="CompanionCard" Visibility="Collapsed" />
                                    <controls:VolumeCard x:Name="VolumeCard" />
                                    <Button x:Name="PlaybackButton" Tag="playback" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [DeviceControls_Playback], Source={StaticResource Loc}}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [DeviceControls_Playback], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="MicrophoneControlsButton" Tag="recorder" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [MicTitle_Text], Source={StaticResource Loc}}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [MicTitle_Text], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="HeadTrackingButton" Tag="headtracking" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Spatial_Title], Source={StaticResource Loc}}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Spatial_Title], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FinderButton" Tag="finder" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [NearbyFinder_Title], Source={StaticResource Loc}}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [NearbyFinder_Title], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CaseButton" Tag="case" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [NearbyCase_Title], Source={StaticResource Loc}}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [NearbyCase_Title], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="MultipointButton" Tag="multipoint" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [MultipointTitle_Text], Source={StaticResource Loc}}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [MultipointTitle_Text], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="HardwareButton" Tag="hardware" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [HardwareChecks_Title], Source={StaticResource Loc}}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [HardwareChecks_Title], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>
                        <controls:DongleCard x:Name="DongleCard" />
                    </StackPanel>
                    <ContentControl x:Name="DetailSections" Visibility="Collapsed" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <StackPanel x:Name="RecorderPage" Spacing="16" Visibility="Collapsed">
                                <controls:MicCard x:Name="MicCard" />
                            </StackPanel>
                            <StackPanel x:Name="HeartRatePage" Spacing="16" Visibility="Collapsed">
                                <controls:HeartRateCard x:Name="HeartRateCard" />
                            </StackPanel>
                            <StackPanel x:Name="HoldPage" Spacing="16" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="HoldRows" />
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="CallPage" Spacing="16" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="CallRows" />
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="MicrophonePage" Spacing="16" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="MicrophoneRows" />
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="EqualizerPage" Spacing="16" Visibility="Collapsed">
                                <controls:EqualizerCard x:Name="EqualizerCard" />
                            </StackPanel>
                            <StackPanel x:Name="HearingPage" Spacing="16" Visibility="Collapsed">
                                <controls:HearingAidCard x:Name="HearingAidCard" />
                            </StackPanel>
                            <StackPanel x:Name="ProtectionPage" Spacing="16" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <ContentControl x:Name="ProtectionHost" HorizontalContentAlignment="Stretch" />
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="AccessibilityPage" Spacing="16" Visibility="Collapsed">
                                <Border x:Name="PressSpeedGroup" Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="PressSpeedRows" />
                                </Border>
                                <Border x:Name="HoldDurationGroup" Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="HoldDurationRows" />
                                </Border>
                                <TextBlock Text="{Binding [NoiseControlTitle_Text], Source={StaticResource Loc}}" Style="{StaticResource SectionTitle}" />
                                <Border x:Name="OneBudGroup" Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="OneBudRows" />
                                </Border>
                                <Button x:Name="AccommodationsButton" Tag="accommodations" Click="Navigate_Click" Style="{StaticResource AppleNavigationButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0" MinHeight="58" AutomationProperties.Name="{Binding [Accommodations_Title], Source={StaticResource Loc}}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Accommodations_Title], Source={StaticResource Loc}}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="1" Glyph="" FontSize="14" Foreground="{ThemeResource AppleSecondaryBrush}" />
                                    </Grid>
                                </Button>
                                <Border x:Name="ToneVolumeGroup" Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="ToneVolumeRows" />
                                </Border>
                                <Border x:Name="VolumeControlGroup" Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="VolumeControlRows" />
                                </Border>
                                <Border x:Name="SwipeSpeedGroup" Style="{StaticResource Card}" Padding="16,0">
                                    <StackPanel x:Name="SwipeSpeedRows" />
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="AccommodationsPage" Spacing="16" Visibility="Collapsed">
                                <controls:AccommodationsCard x:Name="AccommodationsCard" />
                            </StackPanel>
                            <StackPanel x:Name="TransparencyPage" Spacing="16" Visibility="Collapsed">
                                <controls:TransparencyCard x:Name="TransparencyCard" />
                            </StackPanel>
                            <StackPanel x:Name="PlaybackPage" Spacing="16" Visibility="Collapsed">
                                <controls:DeviceSettingsCard x:Name="DeviceSettingsCard" />
                            </StackPanel>
                            <StackPanel x:Name="HeadTrackingPage" Spacing="16" Visibility="Collapsed">
                                <controls:HeadTrackingCard x:Name="HeadTrackingCard" />
                            </StackPanel>
                            <StackPanel x:Name="FinderPage" Spacing="16" Visibility="Collapsed">
                                <controls:NearbyFinderCard x:Name="NearbyFinderCard" />
                            </StackPanel>
                            <StackPanel x:Name="CasePage" Spacing="16" Visibility="Collapsed">
                                <controls:NearbyCaseCard x:Name="NearbyCaseCard" />
                            </StackPanel>
                            <StackPanel x:Name="MultipointPage" Spacing="16" Visibility="Collapsed">
                                <controls:MultipointCard x:Name="MultipointCard" />
                            </StackPanel>
                            <StackPanel x:Name="HardwarePage" Spacing="16" Visibility="Collapsed">
                                <controls:HardwareDiagnosticsCard x:Name="HardwareDiagnosticsCard" />
                            </StackPanel>
                            <StackPanel x:Name="AboutPage" Spacing="16" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="{Binding [DeviceInfoModel_Text], Source={StaticResource Loc}}" FontSize="16" />
                                        <TextBlock x:Name="AboutModel" TextWrapping="Wrap" />
                                        <Border Style="{StaticResource InsetDivider}" Margin="0" />
                                        <TextBlock Text="{Binding [DeviceInfoFirmware_Text], Source={StaticResource Loc}}" FontSize="16" />
                                        <TextBlock x:Name="AboutFirmware" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding [DeviceInfoSerial_Text], Source={StaticResource Loc}}" FontSize="16" />
                                        <TextBox x:Name="AboutSerial" IsReadOnly="True" Visibility="Collapsed" />
                                        <Button x:Name="RevealSerialButton" Content="{Binding [SettingsRevealSerial_Content], Source={StaticResource Loc}}" Click="RevealSerial_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource NavigationScrollEdge}" />
    </Grid>
</UserControl>
