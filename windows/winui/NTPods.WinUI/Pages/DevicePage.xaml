<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NTPods.WinUI.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NTPods.WinUI.Controls">
    <ScrollViewer x:Name="PageScrollViewer" Background="Transparent" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch">
            <StackPanel x:Name="DeviceRoot" MaxWidth="688" Padding="24,20,24,48" Spacing="24" HorizontalAlignment="Stretch">
                <controls:DeviceHeader x:Name="Header" />
                <HyperlinkButton x:Name="PairFirstButton" Visibility="Collapsed" HorizontalAlignment="Center" Click="Pair_Click"
                                 Content="{Binding [Pairing_Title], Source={StaticResource Loc}}" />
                <InfoBar x:Name="PairingError" IsOpen="False" Visibility="Collapsed" Severity="Error" Closed="PairingError_Closed" />
                <ContentControl x:Name="DeviceBody" IsTabStop="False" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="DeviceSections" Spacing="24">
                        <controls:BatteryCard x:Name="BatteryCard" />
                        <controls:NoiseControlCard x:Name="NoiseControlCard" />
                        <controls:FeaturesCard x:Name="FeaturesCard" />
                        <StackPanel x:Name="VolumeSections" Spacing="12">
                            <controls:VolumeCard x:Name="VolumeCard" />
                            <controls:EqualizerCard x:Name="EqualizerCard" />
                        </StackPanel>
                        <controls:MicCard x:Name="MicCard" />
                        <controls:DeviceSettingsCard x:Name="DeviceSettingsCard" />
                        <StackPanel x:Name="ExtraSections" Spacing="12">
                            <controls:HeartRateCard x:Name="HeartRateCard" />
                            <controls:HeadTrackingCard x:Name="HeadTrackingCard" />
                            <controls:HearingAidCard x:Name="HearingAidCard" Visibility="Collapsed" />
                            <controls:TransparencyCard x:Name="TransparencyCard" Visibility="Collapsed" />
                            <controls:HardwareDiagnosticsCard x:Name="HardwareDiagnosticsCard" Visibility="Collapsed" />
                            <controls:MultipointCard x:Name="MultipointCard" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
