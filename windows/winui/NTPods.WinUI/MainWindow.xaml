<Window x:Class="NTPods.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:NTPods.WinUI.Pages" Title="NTPods">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplePageBrush}">
        <Grid x:Name="ShellGrid">
            <pages:DevicePage x:Name="DevicePageView" />
            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="SettingsNavigation" Height="64" MaxWidth="608" Padding="16,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource CircleButton}" Click="Back_Click" AutomationProperties.Name="{Binding [Navigation_Back], Source={StaticResource Loc}}">
                        <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding [SettingsTitle_Text], Source={StaticResource Loc}}" FontFamily="{StaticResource AppleBodyFont}" FontSize="22" FontWeight="ExtraBold" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <pages:SettingsPage x:Name="SettingsPageView" Grid.Row="1" />
                <Border Grid.Row="1" Style="{StaticResource NavigationScrollEdge}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
