<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NTPods.WinUI</RootNamespace>

    <!-- Installer shortcuts and startup entries depend on this executable name. -->
    <AssemblyName>ntpods-winui</AssemblyName>
    <Version>0.1.26</Version>

    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- The MSI ships the app and its runtime without MSIX registration. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Disable default discovery because Strings is included explicitly below. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <EnableDefaultPRIResourceItems>false</EnableDefaultPRIResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\device-models.json" LogicalName="ntpods.device-models.json" />
    <!-- Retain the resource index required by the unpackaged app. -->
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loc reads embedded strings for live language switching; keep these in sync with Loc.Cultures. -->
    <EmbeddedResource Include="Strings\en-US\Resources.resw" LogicalName="loc.en-US" />
    <EmbeddedResource Include="Strings\pt-PT\Resources.resw" LogicalName="loc.pt-PT" />
    <EmbeddedResource Include="Strings\fr-FR\Resources.resw" LogicalName="loc.fr-FR" />
    <EmbeddedResource Include="Strings\es-ES\Resources.resw" LogicalName="loc.es-ES" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <!-- GPU displacement and spectral sampling for the LibrePods glass selector. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <!-- GDI (System.Drawing.Icon/Bitmap/Graphics) for the tray's number-badge icon. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <!-- Reads the daemon's heart-rate history DB (Services/HeartRateHistory.cs). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Explicit fixed native SQLite bundle; 2.1.11 carries CVE-2025-6965. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- App/tray icons next to the exe (ms-appx:///Assets URIs + AppWindow.SetIcon). -->
    <Content Include="Assets\tray.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Include new artwork without maintaining a second file list. -->
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\pairing_spin.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
