  "narrative": {
    "northStar": "LibrePods Apple appearance with native Windows controls",
    "overview": "NTPods follows LibrePods' Apple appearance: a light gray or black page, rounded inset groups, device artwork, green switches and battery rings. Text, navigation, keyboard controls and accessibility use native Windows behavior.",
    "keyCharacteristics": [],
    "rules": [],
    "dos": [
      "Do use theme resources for custom fills and preserve Windows high-contrast mappings.",
      "Do keep localized labels, visible keyboard focus and accessible names on custom compositions.",
      "Do display confirmed, pending, unavailable and error states distinctly.",
      "Do reuse the existing device artwork and proportional image scaling."
    ],
    "donts": [
      "Show Off according to the model and Allow Off setting; hide it while Adaptive is expanded.",
      "Don't treat a drag preview or an outgoing request as confirmed device state.",
